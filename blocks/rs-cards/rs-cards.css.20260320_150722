.rscards-container {
  /* Equivalent to 16px assuming 16px base */
  margin: 0 3rem 1.25rem;
}
.rscards-container .rscards-row {
  margin-left: 0;
  margin-right: 0;
}
.rscards-container .rscards-row .rscards-row-gap-4 {
  /* Equivalent to 16px assuming 16px base */
  margin-bottom: 1rem;
}
.rscards-card {
  height: 100%;
  border-radius: 40px;
  background-color: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.125);
  display: flex;
  flex-direction: column;
  min-height: 460px; /* Equivalent to 460px assuming 16px base */
  position: relative;
  word-wrap: break-word;
  background-clip: border-box;
}
.rscards-card .rscards-kitchens-image {
  object-fit: fill;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  min-height: 190px; /* Equivalent to 190px assuming 16px base */
  height: 100%;
  width: 100%;
  display: block;
}
.rscards-card .rscards-card-body {
  position: absolute;
  bottom: 0;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  background: linear-gradient(0deg, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0) 100%);
  color: #ffffff;
  /* Equivalent to 24px assuming 16px base */
  padding: 24px 35px 25px;
  flex: 1 1 auto;
  min-height: 1px;
  width: 100%;
}
.rscards-card .rscards-card-body .rscards-blog-card-title {
  /* Equivalent to 22px assuming 16px base */
  font-size: 1.375rem;
  font-family: "Paytone One";
  font-weight: 500;
  /* Equivalent to 8px assuming 16px base */
  margin-bottom: 8px;
  /* Equivalent to 26.4px assuming 16px base */
  line-height: 1.65rem;
}
.rscards-card .rscards-card-body .rscards-card-title {
  /* Equivalent to 16px assuming 16px base */
  font-size: 1rem;
  font-family: "Paytone One";
  font-weight: 500;
  /* Equivalent to 12px assuming 16px base */
  margin-bottom: 12px;
  /* Equivalent to 19.2px assuming 16px base */
  line-height: 1.2rem;
}
.rscards-card .rscards-card-title p {
  /* Equivalent to 16px assuming 16px base */
  font-size: 1rem;
  font-family: "Paytone One";
  font-weight: 400;
  /* Equivalent to 16px assuming 16px base */
  margin-bottom: 16px;
  /* Equivalent to 19.2px assuming 16px base */
  line-height: 1.2rem;
}
@media (max-width: 768px) {
  .rscards-card {
    width: 80%;
    justify-self: center;
  }
  .rscards-card .rscards-card-body .rscards-blog-card-title {
    /* Equivalent to 21px assuming 16px base */
    font-size: 1.313rem;
  }
  .rscards-card .rscards-card-body .rscards-card-title p {
    /* Equivalent to 16px assuming 16px base */
    font-size: 1rem;
  }
  .rscards-col-xl-4 {
    /* Equivalent to 0px assuming 16px base */
    padding-left: 0;
    /* Equivalent to 0px assuming 16px base */
    padding-right: 0;
  }
}
@media (max-width: 767.98px) {
  .rscards-col-xl-4 {
    /* Equivalent to 0px assuming 16px base */
    padding-left: 0;
    /* Equivalent to 0px assuming 16px base */
    padding-right: 0;
  }
}