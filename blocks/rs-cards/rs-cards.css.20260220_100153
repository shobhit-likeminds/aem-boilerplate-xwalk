.rscards-container {
  .row {
    margin-left: 0;
    margin-right: 0;
  }

  .rscards-rs-card {
    height: 100%;
    border-radius: 40px;

    .rscards-kitchens-image {
      object-fit: fill !important;
      border-bottom-left-radius: 40px;
      border-bottom-right-radius: 40px;
    }

    .rscards-card-body {
      position: absolute;
      bottom: 0;
      border-bottom-left-radius: 40px;
      border-bottom-right-radius: 40px;
      background: linear-gradient(0deg, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0) 100%);
      color: #fff; /* Equivalent to var(--white) */
      padding: 24px 35px 25px !important;

      @media (max-width: 767.98px) {
        .rscards-blog-card-title {
          font-size: 26px;
        }

        .rscards-card-title p {
          font-size: 16px;
        }
      }

      .rscards-blog-card-title {
        font-size: 1.375rem; /* Equivalent to 22px assuming 16px base */

        @media (max-width: 768px) {
          font-size: 1.313rem; /* Equivalent to 21px assuming 16px base */
        }
      }

      .rscards-card-title {
        font-size: 1rem; /* Equivalent to 16px assuming 16px base */
      }
    }

    @media (max-width: 768px) {
      width: 80%;
      justify-self: center;
    }
  }

  @media (max-width: 768px) {
    .rscards-koi-rscard-padding {
      padding-left: 0;
      padding-right: 0;
    }
  }

  @media (min-width: 768px) {
    margin: 0 3rem 1.25rem;

    .row .row-gap-4 {
      margin-bottom: 1rem;
    }
  }
}

.rscards-card {
  min-height: 460px;

  > img {
    min-height: 190px;
    height: 100%;
    object-fit: cover;
    border-radius: 40px 40px 0 0;
  }
}

.rscards-rightshift-image {
  display: none;
}

.rscards-kitchens-image {
  display: none;
}

.rscards-card-body {
  padding: 24px 35px 45px 35px;
}

#rscards-explore-btn-hide-id {
  display: none;
}