import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  const ul = document.createElement('ul');
  ul.classList.add('footer-list', 'd-flex', 'align-items-center', 'justify-content-center', 'align-items-md-start', 'flex-column');

  [...block.children].forEach((row) => {
    const cells = [...row.children];
    // Based on BlockJson and EDS Block Structure:
    // cell[0]: field="link" type=aem-content (contains <a>)
    // cell[1]: field="linkLabel" type=text (plain text)
    // We can safely use index access here because the model defines a fixed structure for 'footer-list-item'
    const linkCell = cells[0];
    const linkLabelCell = cells[1];

    const li = document.createElement('li');
    moveInstrumentation(row, li);
    li.classList.add('footer-list__item');

    const anchor = document.createElement('a');
    anchor.classList.add('cta-analytics', 'analytics_cta_click', 'footer-list__item--link', 'd-inline-block');

    const foundLink = linkCell.querySelector('a');
    if (foundLink) {
      anchor.href = foundLink.href;
    }
    anchor.textContent = linkLabelCell.textContent.trim();
    anchor.setAttribute('data-link-region', 'Footer'); // Add data attribute from original HTML

    li.append(anchor);
    ul.append(li);
  });

  block.textContent = '';
  block.append(ul);
}
