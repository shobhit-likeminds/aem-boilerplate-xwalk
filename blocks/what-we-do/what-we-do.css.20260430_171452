.row { --bs-gutter-x:1.5rem;--bs-gutter-y:0;display:flex;flex-wrap:wrap;margin-top:calc(-1 * var(--bs-gutter-y));margin-right:calc(-.5 * var(--bs-gutter-x));margin-left:calc(-.5 * var(--bs-gutter-x)) }

.row>* { flex-shrink:0;width:100%;max-width:100%;padding-right:calc(var(--bs-gutter-x) * .5);padding-left:calc(var(--bs-gutter-x) * .5);margin-top:var(--bs-gutter-y) }

.col { flex:1 0 0 }

.row-cols-1>* { flex:0 0 auto;width:100% }

.g-3 { --bs-gutter-x:1rem }

.g-3, .gy-3 { --bs-gutter-y:1rem }

@media (min-width:992px) { .row-cols-lg-3>* { flex:0 0 auto;width:33.33333333% } }

.d-none { display:none!important }

@media (min-width:992px) { .d-lg-block { display:block!important } .d-lg-none { display:none!important } }

/* Card structure — required because images are lazy-loaded with no intrinsic dimensions */
.what-we-do-wrap .wrap {
  position: relative;
  display: block;
  overflow: hidden;
}

.what-we-do-wrap .image {
  height: 230px;
}

.what-we-do-wrap .image picture,
.what-we-do-wrap .image img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.what-we-do-wrap .title {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 2rem 1.25rem 1rem;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.65));
}

.what-we-do-wrap .stretched-link::after {
  z-index: 2;
}