import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  // Use content detection instead of direct index access for robustness
  const rows = [...block.children];

  const imageRow = rows.find((row) => row.querySelector('picture'));
  const titleRow = rows.find((row) => row.textContent.trim() === 'Title value'); // Assuming unique text for title
  const textRow = rows.find((row) => row.querySelector('p') && row.querySelector('p').textContent.includes('Text text content')); // Assuming unique text for text
  const ctaLinkRow = rows.find((row) => row.querySelector('a') && row.querySelector('a').href.includes('ctaLink'));
  const ctaLinkLabelRow = rows.find((row) => row.querySelector('a') && row.querySelector('a').href.includes('ctalinklabel'));
  const captionRow = rows.find((row) => row.textContent.trim() === 'Caption value'); // Assuming unique text for caption

  // Section wrapper
  const section = document.createElement('section');
  section.classList.add('theme-light', 'theme-bg', 'theme-section-spacing');
  section.setAttribute('data-testid', 'featured-cta-rectangle');

  // Container div
  const container = document.createElement('div');
  container.classList.add('container');
  section.append(container);

  // Main grid div
  const mainGrid = document.createElement('div');
  mainGrid.classList.add('grid', 'grid-full', 'md:gap-grid-gutter', 'justify-center', 'items-center');
  container.append(mainGrid);

  // Image column
  const imageCol = document.createElement('div');
  imageCol.classList.add(
    'order-1', 'md:order-2', 'relative', 'md:col-start-8', 'md:col-span-8',
    'xl:col-start-7', 'xl:col-span-7', 'lg:z-10', 'min-w-0', 'md:row-start-1',
    'md:row-end-1',
  );
  imageCol.setAttribute('data-testid', 'featured-cta-image');
  mainGrid.append(imageCol);

  const imageAspectWrapper = document.createElement('div');
  imageAspectWrapper.classList.add('aspect-4/3', 'max-w-[672px]', 'w-full', 'mx-auto');
  imageCol.append(imageAspectWrapper);

  if (imageRow) { // Ensure imageRow exists before querying
    const picture = imageRow.querySelector('picture');
    if (picture) {
      const img = picture.querySelector('img');
      const optimizedPic = createOptimizedPicture(img.src, img.alt, false, [{ width: '672' }]);
      const optimizedImg = optimizedPic.querySelector('img');
      optimizedImg.classList.add(
        'rounded-t-sm', 'md:rounded-sm', 'overflow-hidden', 'w-full', 'h-auto',
      );
      optimizedImg.setAttribute('height', '504'); // From original HTML
      optimizedImg.setAttribute('width', '672'); // From original HTML
      moveInstrumentation(img, optimizedImg);
      imageAspectWrapper.append(optimizedPic);
    }
  }

  // Content column
  const contentCol = document.createElement('div');
  contentCol.classList.add(
    'order-2', 'md:order-1', 'relative', 'md:col-span-8', 'md:col-start-1',
    'xl:col-start-2', 'xl:col-span-6', 'md:z-20', 'bg-card-surface',
    'theme-dark:bg-card-surface-td', 'theme-medium:bg-card-surface-tm',
    'text-foreground', 'theme-dark:text-foreground-tm',
    'theme-medium:text-foreground-td', 'rounded-sm', 'flex', 'flex-col',
    'justify-center', 'space-y-2xs', 'p-6', 'xl:p-lg', 'md:row-start-1',
    'md:row-end-1',
  );
  mainGrid.append(contentCol);

  // Title
  if (titleRow) { // Ensure titleRow exists
    const title = document.createElement('h4');
    title.classList.add('text-h4', 'font-bold');
    title.setAttribute('data-testid', 'featured-cta-title');
    moveInstrumentation(titleRow, title);
    title.textContent = titleRow.textContent.trim();
    contentCol.append(title);
  }

  // Text
  if (textRow) { // Ensure textRow exists
    const textDiv = document.createElement('div');
    textDiv.classList.add(
      'prose', 'theme-dark:prose-tm', 'theme-medium:prose-td', 'max-w-none',
    );
    textDiv.setAttribute('data-testid', 'featured-cta-text');
    moveInstrumentation(textRow, textDiv);
    while (textRow.firstChild) textDiv.append(textRow.firstChild);
    contentCol.append(textDiv);
  }

  // CTA Links wrapper
  const linksWrapper = document.createElement('div');
  linksWrapper.classList.add('flex', 'flex-wrap', 'gap-xs', 'mt-6');
  linksWrapper.setAttribute('data-testid', 'featured-cta-links');
  contentCol.append(linksWrapper);

  // CTA Link
  if (ctaLinkRow && ctaLinkLabelRow) { // Ensure both rows exist
    const ctaLink = document.createElement('a');
    const originalCtaLink = ctaLinkRow.querySelector('a');
    if (originalCtaLink) {
      ctaLink.href = originalCtaLink.href;
    }
    ctaLink.classList.add(
      'w-full', 'md:w-auto', 'button', 'button--dark', 'theme-medium:button--light',
    );
    ctaLink.setAttribute('data-testid', 'featured-cta-link-primary');
    moveInstrumentation(ctaLinkRow, ctaLink);
    // Use ctaLinkLabel for anchor text
    ctaLink.textContent = ctaLinkLabelRow.textContent.trim();
    linksWrapper.append(ctaLink);
  }

  // Caption grid div
  const captionGrid = document.createElement('div');
  captionGrid.classList.add('grid-full', 'grid-centered-12');
  container.append(captionGrid);

  const captionCol = document.createElement('div');
  captionCol.classList.add(
    'md:text-end', 'order-1', 'md:order-2', 'relative', 'md:col-start-8',
    'md:col-span-8', 'xl:col-start-8', 'xl:col-span-6', 'lg:z-10', 'min-w-0',
    'md:row-start-1', 'md:row-end-1',
  );
  captionGrid.append(captionCol);

  const captionWrapper = document.createElement('div');
  captionWrapper.classList.add('mt-2xs');
  captionCol.append(captionWrapper);

  // Caption
  if (captionRow) { // Ensure captionRow exists
    const caption = document.createElement('p');
    caption.classList.add(
      'z-1', 'relative', 'text-caption-size', 'theme-dark:text-foreground-colored-muted',
      'text-foreground-muted',
    );
    moveInstrumentation(captionRow, caption);
    caption.textContent = captionRow.textContent.trim();
    captionWrapper.append(caption);
  }

  block.textContent = '';
  block.append(section);
}
