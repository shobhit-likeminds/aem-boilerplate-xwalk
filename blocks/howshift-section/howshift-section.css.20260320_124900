.howshift-section {
  background-color: #ffedd6;
  display: flex;
  flex-direction: row;
  font-family: 'Urbanist';
}
.howshift-section .howshift-left-image-div {
  width: 100%;
}
.howshift-section .howshift-left-image-div img {
  width: 100%;
  height: 100%;
}
.howshift-section .howshift-container {
  padding: 22px 30px;
}
.howshift-section .howshift-container .howshift-read-more-text {
  text-align: center;
  max-width: 450px;
  margin: 0 auto;
}
.howshift-section .howshift-container .howshift-read-more-text h2 {
  text-align: center;
  font-size: 2rem; /* Equivalent to 32px assuming 16px base */
  font-weight: 500;
  line-height: 1.2;
  color: #212529;
  margin-bottom: 0.5rem;
}
.howshift-section .howshift-container .howshift-read-more-text p {
  text-align: center;
  margin-top: 0px;
  margin-bottom: 1rem;
  font-size: 1rem; /* Equivalent to 16px assuming 16px base */
  font-weight: 400;
  line-height: 1.5;
  color: #212529;
}
.howshift-section .howshift-container .howshift-how-shift-button {
  display: flex;
  justify-content: center;
  margin-top: 40px;
}
.howshift-section .howshift-container .howshift-how-shift-button a {
  background-color: #2d2119 !important;
  padding: 15px 66px;
  color: #fcf1e4;
  border: transparent;
  border-radius: 28px;
  font-weight: 700;
  font-size: 1.5rem; /* Equivalent to 24px assuming 16px base */
  line-height: 1.5;
  text-align: center;
  text-decoration: none;
  transition: color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
}
.howshift-section .howshift-container .howshift-how-shift-button a:hover {
  opacity: 0.6;
  border-color: unset !important;
  box-shadow: none !important;
  text-decoration: none !important;
}
@media (max-width: 767.98px) {
  .howshift-section {
    text-align: center;
    flex-direction: column;
  }
}
.howshift-section .howshift-health-goal-wrapper {
  background-color: #2d2119;
}
.howshift-section .howshift-heading {
  padding-bottom: 0.5rem !important;
  font-size: 2.5rem; /* Equivalent to 40px assuming 16px base */
  font-family: 'Paytone One';
  font-weight: 500;
  line-height: 1.2;
  color: #4f250a;
  margin-bottom: 0.5rem;
}
.howshift-section p {
  margin: 0 auto;
  font-size: 1.25rem; /* Equivalent to 20px assuming 16px base */
  font-weight: 400;
  line-height: 1.5;
  color: #2d2119;
  margin-bottom: 1rem;
}
@media (max-width: 767.98px) {
  .howshift-section .howshift-health-goal-wrapper img {
    width: 83px;
  }
  .howshift-section .howshift-heading, .howshift-section .howshift-read-more-text h2 {
    font-size: 1.5rem; /* Equivalent to 24px assuming 16px base */
  }
}
@media (max-width: 390px) {
  .howshift-section .howshift-heading {
    padding: 0 12vw !important;
  }
}
.howshift-section {
  margin: 1rem 3rem;
}
@media (max-width: 768px) {
  .howshift-section {
    margin: 0.5rem 1.5rem;
  }
}
.howshift-section .howshift-container .howshift-how-shift-button {
  justify-content: flex-start;
  margin-left: 2.5rem;
}
@media (max-width: 767.98px) {
  .howshift-section .howshift-container .howshift-how-shift-button {
    justify-content: center;
    margin: 0px;
  }
}
.howshift-why-shift-wrapper {
  max-width: 700px;
  margin: 0 auto;
}
.howshift-why-shift-wrapper .howshift-image-label {
  text-decoration: none;
  color: #000;
  font-weight: 500;
  font-size: 1rem; /* Equivalent to 16px assuming 16px base */
  line-height: 1.5;
}
.howshift-why-shift-wrapper .howshift-health-goal-wrapper {
  margin: 0 auto;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 180%;
  background-color: #fcf1e4;
  min-height: unset;
  min-width: unset;
}
.howshift-why-shift-wrapper .howshift-health-goal-wrapper img {
  width: 99px;
  height: 99px;
  object-fit: fill;
  object-position: 50% 50%;
}
.howshift-button a.howshift-cmp-button {
  color: #fcf1e4;
  background-color: #2d2119;
  border-color: #2d2119;
  border: 1px solid transparent;
  padding: 15px 66px;
  font-size: 1.5rem; /* Equivalent to 24px assuming 16px base */
  line-height: 1.5;
  border-radius: 28px;
  font-weight: 700;
  text-align: center;
  text-decoration: none;
  transition: color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
}
.howshift-button a.howshift-cmp-button:hover {
  opacity: 0.6;
  border-color: unset !important;
  box-shadow: none !important;
  text-decoration: none !important;
}
.howshift-d-md-none {
  display: none;
}
@media (min-width: 768px) {
  .howshift-d-md-none {
    display: none !important;
  }
}
.howshift-d-block {
  display: block;
}
@media (min-width: 576px) {
  .howshift-d-block {
    display: block !important;
  }
}
.howshift-text-center {
  text-align: center !important;
}
.howshift-pb-4 {
  padding-bottom: 1.5rem !important;
}
.howshift-justify-content-evenly {
  justify-content: space-evenly !important;
}
.howshift-flex-wrap {
  flex-wrap: wrap !important;
}
.howshift-d-flex {
  display: flex !important;
}
.howshift-mb-md-0 {
  margin-bottom: 0px !important;
}
@media (min-width: 768px) {
  .howshift-mb-md-0 {
    margin-bottom: 0px !important;
  }
}
.howshift-mb-3 {
  margin-bottom: 1rem !important;
}
