.container { --bs-gutter-x:1.5rem;--bs-gutter-y:0;margin-left:auto;margin-right:auto;padding-left:calc(var(--bs-gutter-x)*.5);padding-right:calc(var(--bs-gutter-x)*.5);width:100% }

@media(min-width:1200px) { .container { max-width:855pt } }

@media(min-width:1400px) { .container { max-width:990pt } }

@media(min-width:576px) { .gx-sm-0 { --bs-gutter-x:0 } }

.bg-cream-100 { --bs-bg-opacity:1;background-color:#fff6e3!important }

.bg-cream-300 { --bs-bg-opacity:1;background-color:#f9e8bf!important }

/* Ratio utilities */
.ratio { position:relative;width:100% }
.ratio::before { display:block;padding-top:var(--bs-aspect-ratio);content:'' }
.ratio>* { height:100%;left:0;position:absolute;top:0;width:100% }
.ratio-3x4 { --bs-aspect-ratio:133.3333% }
.ratio-1x1 { --bs-aspect-ratio:100% }

/* Product card layout */
.product-cards__card { min-width:0 }

.product-cards__card-media { padding-bottom:6rem }

.product-cards__card-thumb { width:100%;height:100% }

.card-gradient { background:linear-gradient(180deg,rgba(0,0,0,.45) 0%,transparent 60%) }

.product-cards__card-title { z-index:1 }

/* Circle product image pinned at the bottom edge of the background image */
.product-cards__card-img { width:120px;transform:translateX(-50%);z-index:1 }

.rounded-top-circle { border-radius:50% 50% 0 0 }

/* Navigation buttons */
.card-carousel__navigation { width:40px;height:40px;border:2px solid currentColor }

.card-carousel__swiper--prev { transform:rotate(180deg) }

@media(min-width:576px) {
  .d-sm-flex { display:-webkit-box!important;display:-ms-flexbox!important;display:flex!important }
  .mt-sm-10 { margin-top:2.5rem!important }
  .mx-sm-0 { margin-left:0!important;margin-right:0!important }
  .pt-sm-6 { padding-top:1.5rem!important }
  .product-cards__card-img { width:100px }
}

@media(min-width:768px) {
  .d-md-block { display:block!important }
  .flex-md-row { -webkit-box-orient:horizontal!important;-ms-flex-direction:row!important;flex-direction:row!important }
  .flex-md-column,.flex-md-row { -webkit-box-direction:normal!important }
  .flex-md-column { -webkit-box-orient:vertical!important;-ms-flex-direction:column!important;flex-direction:column!important }
  .justify-content-md-center { -webkit-box-pack:center!important;-ms-flex-pack:center!important;justify-content:center!important }
  .mx-md-0 { margin-left:0!important;margin-right:0!important }
  .px-md-8 { padding-left:2rem!important;padding-right:2rem!important }
}

@media(min-width:992px) { .pt-lg-8 { padding-top:2rem!important } }

@media(min-width:1200px) {
  .mt-xl-7 { margin-top:1.75rem!important }
  .leading-xl-30 { line-height:1.875rem }
  .product-cards__card-img { width:120px }
  .pt-lg-8 { padding-top:2rem!important }
}
