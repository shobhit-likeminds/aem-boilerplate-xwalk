      const socialLinksWrapper = document.createElement('div');
      socialLinksWrapper.classList.add('swiper-wrapper');
      socialShareIconsWrapper.append(socialLinksWrapper);

      // Process social media links from socialMediaLinkRows
      socialMediaLinkRows.forEach((linkRow) => {
        const linkCells = [...linkRow.children];
        const [socialLinkCell, socialIconCell, socialLabelCell] = linkCells;

        const iconLabelDiv = document.createElement('div');
        iconLabelDiv.classList.add('social-media-share__wrapper--icon-label', 'swiper-slide', 'd-flex', 'align-items-center');
        moveInstrumentation(linkRow, iconLabelDiv); // Move instrumentation for each social link item
