      socialPrevButton.classList.add('social-media-share__button', 'bg-transparent', 'border-0', 'social-media-share__prev', 'd-none', 'z-2', 'd-md-block', 'position-absolute', 'swiper-button-prev');
      socialShareIconsWrapper.append(socialPrevButton);

