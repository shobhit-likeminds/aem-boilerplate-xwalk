      recipeCardProperties.append(timeProperty);

      const timeIconPicture = timeIconCell.querySelector('picture');
      if (timeIconPicture) {
        const timeIconImg = timeIconPicture.querySelector('img');
        const optimizedTimeIcon = createOptimizedPicture(timeIconImg.src, timeIconImg.alt, false, [{ width: '24' }]);
        timeProperty.append(optimizedTimeIcon);
      }

      const timeSpan = document.createElement('span');
      timeSpan.classList.add('recipe-card__time', 'text-dark-gray-100', 'font-14', 'font-xl-default', 'leading-20', 'fw-medium', 'ms-2', 'd-inline-block', 'text-nowrap');
