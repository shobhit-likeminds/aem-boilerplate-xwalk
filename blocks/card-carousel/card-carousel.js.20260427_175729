        servesProperty.append(optimizedServesIcon);
      }

      const servesSpan = document.createElement('span');
      servesSpan.classList.add('serve-content', 'recipe-card__serves', 'text-dark-gray-100', 'font-14', 'font-xl-default', 'leading-20', 'fw-medium', 'ms-2', 'd-inline-block');
      servesSpan.textContent = servesCell.textContent.trim();
      servesProperty.append(servesSpan);

      const hierarchyRoot = hierarchyCell?.querySelector('ul');
      if (hierarchyRoot) {
        // This is where the hierarchy tree would be appended if needed for the card,
        // but based on the original HTML, it's not displayed directly in the card.
        // If it were, we'd append it and transform it here.
        // For now, it's just read from the model.
      }

      swiperWrapper.append(swiperSlide);
    } else if (cells.length === 5) {
      // Social Media Share item (main container)
      const [closeIconCell, linksCell, prevIconCell, nextIconCell, copyLabelCell] = cells;

      const closeIconPicture = closeIconCell.querySelector('picture');
      if (closeIconPicture) {
        const closeIconImg = closeIconPicture.querySelector('img');
        const optimizedCloseIcon = createOptimizedPicture(closeIconImg.src, closeIconImg.alt, false, [{ width: '24' }]);
        socialShareClose.append(optimizedCloseIcon);
