        hiddenInput.type = 'hidden';
        hiddenInput.classList.add('social-media-share__wrapper--url');
        hiddenInput.value = socialLabelCell.textContent.trim().toLowerCase().replace(/\s/g, '');
        iconLabelDiv.append(hiddenInput);
      });

