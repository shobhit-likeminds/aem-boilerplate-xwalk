  const prevImg = prevButton.querySelector('img');
  if (prevImg) {
    const optimizedPrevImg = createOptimizedPicture(prevImg.src, prevImg.alt, false, [{ width: '24' }]);
    prevButton.replaceChildren(optimizedPrevImg);
  }

  const nextImg = nextButton.querySelector('img');
  if (nextImg) {
    const optimizedNextImg = createOptimizedPicture(nextImg.src, nextImg.alt, false, [{ width: '24' }]);
    nextButton.replaceChildren(optimizedNextImg);
  }

  block.replaceChildren(root, swiperContainer);

  // Initialize Swiper
  await loadCSS('https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css');
  await loadScript('https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js');
  // eslint-disable-next-line no-undef
  new Swiper(swiperContainer, {
    slidesPerView: 'auto',
    spaceBetween: 34,
    loop: swiperContainer.dataset.loop === 'true',
    navigation: {
      prevEl: prevButton,
      nextEl: nextButton,
    },
    pagination: {
      el: pagination,
      clickable: true,
    },
    breakpoints: {
      576: { slidesPerView: 2 },
      768: { slidesPerView: 3 },
      992: { slidesPerView: 4 },
    },
  });

  // Social share Swiper initialization
  // eslint-disable-next-line no-undef
  new Swiper(socialShareIconsWrapper, {
    slidesPerView: 'auto',
    spaceBetween: 16,
    navigation: {
      prevEl: socialShareSection.querySelector('.social-media-share__prev'),
      nextEl: socialShareSection.querySelector('.social-media-share__next'),
    },
  });

  // Event listener for social share close button
  socialShareClose.addEventListener('click', () => {
    socialShareSection.classList.add('d-none');
  });

  // Event listener for copy button
  copyButton.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(shareInput.value);
      // Optionally provide user feedback
    } catch (err) {
      // Handle error
    }
  });
}
