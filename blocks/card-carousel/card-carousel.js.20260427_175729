      if (nextIconPicture) {
        const nextIconImg = nextIconPicture.querySelector('img');
        const optimizedNextIcon = createOptimizedPicture(nextIconImg.src, nextIconImg.alt, false, [{ width: '24' }]);
        socialNextButton.append(optimizedNextIcon);
