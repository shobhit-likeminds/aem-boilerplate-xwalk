  ctaLink.append(ctaLabel);
  ctaWrapper.append(ctaLink);

  // Separate item rows for social media links
  const socialMediaLinkRows = [];
  const processedItemRows = [];

  itemRows.forEach((row) => {
    const cells = [...row.children];
    // Check if it's a social-media-share-link item (3 cells: link, icon, label)
    // This assumes social-media-share-link items are distinct from the main social-media-share item
    // and appear as separate rows after the main social-media-share item, or mixed in.
    // Based on the BlockJson, 'links' is a container field, meaning its items
    // would appear as separate rows.
    if (cells.length === 3 && cells[0].querySelector('a') && cells[1].querySelector('picture')) {
      socialMediaLinkRows.push(row);
    } else {
      processedItemRows.push(row);
    }
  });

  processedItemRows.forEach((row) => {
    const cells = [...row.children];
    if (cells.length === 12) {
      // Recipe Card item
      const [
        recipeLinkCell,
        imageCell,
        imageAltCell,
        tagCell,
        tagIconCell,
        titleCell,
        descriptionCell,
        timeIconCell,
        timeCell,
        servesIconCell,
        servesCell,
        hierarchyCell,
