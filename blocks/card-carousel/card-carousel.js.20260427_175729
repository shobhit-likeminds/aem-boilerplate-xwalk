      recipeCardTitle.textContent = titleCell.textContent.trim();
      recipeCardText.append(recipeCardTitle);

      const recipeCardDesc = document.createElement('p');
      recipeCardDesc.classList.add('recipe-card__desc', 'font-default', 'font-xl-18', 'leading-24', 'fw-medium', 'text-dark-gray-100', 'mt-4');
      recipeCardDesc.textContent = descriptionCell.textContent.trim();
      recipeCardText.append(recipeCardDesc);

      const recipeCardWave = document.createElement('div');
      recipeCardWave.classList.add('recipe-card__wave', 'mt-11', 'mt-xl-7', 'w-100');
      recipeCardContent.append(recipeCardWave);

      const recipeCardProperties = document.createElement('ul');
      recipeCardProperties.classList.add('recipe-card__properties', 'mt-4', 'd-flex', 'align-items-center', 'mt-4');
