import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  const columnsContainer = document.createElement('div');
  columnsContainer.classList.add('wp-block-columns', 'is-layout-flex', 'wp-container-core-columns-is-layout-9d6595d7', 'wp-block-columns-is-layout-flex');

  [...block.children].forEach((row) => {
    const column = document.createElement('div');
    moveInstrumentation(row, column);
    column.classList.add('wp-block-column', 'is-layout-flow', 'wp-block-column-is-layout-flow');

    const linkEl = document.createElement('a');
    linkEl.classList.add('mind-module');

    const cells = [...row.children];
    // Based on BlockJson model 'mind-module' fields: link, image, title, description
    const linkCell = cells[0];
    const imageCell = cells[1];
    const titleCell = cells[2];
    const descriptionCell = cells[3];

    // Process Link
    const foundLink = linkCell.querySelector('a');
    if (foundLink) {
      linkEl.href = foundLink.href;
    }

    // Process Image
    if (imageCell) {
      const imageDiv = document.createElement('div');
      imageDiv.classList.add('mind-module-image');
      moveInstrumentation(imageCell, imageDiv);
      while (imageCell.firstChild) imageDiv.append(imageCell.firstChild);
      linkEl.append(imageDiv);
    }

    // Process Title
    if (titleCell) {
      const titleEl = document.createElement('h3');
      titleEl.classList.add('mind-module-title');
      const heading = titleCell.querySelector('h1, h2, h3, h4, h5, h6');
      if (heading) {
        moveInstrumentation(heading, titleEl);
        while (heading.firstChild) titleEl.append(heading.firstChild);
      } else if (titleCell.textContent.trim()) {
        moveInstrumentation(titleCell, titleEl);
        titleEl.textContent = titleCell.textContent.trim();
      }
      linkEl.append(titleEl);
    }

    // Process Description
    if (descriptionCell) {
      const descriptionDiv = document.createElement('div');
      descriptionDiv.classList.add('mind-module-description', 'block_mob_desc');
      moveInstrumentation(descriptionCell, descriptionDiv);
      while (descriptionCell.firstChild) descriptionDiv.append(descriptionCell.firstChild);
      linkEl.append(descriptionDiv);
    }

    column.append(linkEl);
    columnsContainer.append(column);
  });

  columnsContainer.querySelectorAll('picture > img').forEach((img) => {
    const optimizedPic = createOptimizedPicture(img.src, img.alt, false, [{ width: '750' }]);
    moveInstrumentation(img, optimizedPic.querySelector('img'));
    img.closest('picture').replaceWith(optimizedPic);
  });

  block.textContent = '';
  block.append(columnsContainer);
}
