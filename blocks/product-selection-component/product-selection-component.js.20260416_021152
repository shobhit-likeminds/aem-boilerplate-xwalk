import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  const [
    headingRow,
    gheeBackgroundDesktopRow,
    gheeBackgroundMobileRow,
    gheeTextRow,
    gheeReportLinkRow,
    gheeReportLinkLabelRow,
    milkBackgroundDesktopRow,
    milkBackgroundMobileRow,
    milkTextRow,
    milkWhatsappLinkRow,
    milkWhatsappLinkLabelRow,
    ...productItemRows
  ] = [...block.children];

  block.classList.add('container-xl', 'annualReport_mainBox', 'product-selection-component');

  const accountMainBox = document.createElement('div');
  accountMainBox.classList.add('account-mainBox', 'mx-md-16');
  block.append(accountMainBox);

  const row = document.createElement('div');
  row.classList.add('row', 'gx-5');
  accountMainBox.append(row);

  // Left Section
  const leftSection = document.createElement('div');
  leftSection.classList.add('mt-8', 'mt-md-10', 'col-lg-4');
  row.append(leftSection);

  const headingP = document.createElement('p');
  headingP.classList.add('font-24', 'font-md-40', 'fw-bold', 'product-container_heading', 'font-baskerville');
  moveInstrumentation(headingRow.firstElementChild, headingP);
  headingP.textContent = headingRow.firstElementChild.textContent.trim();
  leftSection.append(headingP);

  const productMainBox = document.createElement('div');
  productMainBox.classList.add('product-mainbox', 'mt-10', 'mt-md-12');
  leftSection.append(productMainBox);

  productItemRows.forEach((productItemRow, index) => {
    const [imageCell, labelCell] = [...productItemRow.children];

    const productDiv = document.createElement('div');
    const productItem = document.createElement('div');
    productItem.classList.add('milk_ghee_smallImag', 'product-hover');
    moveInstrumentation(productItemRow, productItem);

    const picture = imageCell.querySelector('picture');
    if (picture) {
      const img = picture.querySelector('img');
      const optimizedPic = createOptimizedPicture(img.src, img.alt, false, [{ width: '750' }]);
      moveInstrumentation(img, optimizedPic.querySelector('img'));
      optimizedPic.classList.add('left-section-gheeBox', 'object-fit-contain');
      productItem.append(optimizedPic);
    }

    const p = document.createElement('p');
    p.classList.add('product-subnames');
    p.textContent = labelCell.textContent.trim();
    productItem.append(p);

    if (index === 0) { // Ghee
      productItem.classList.add('ghee-packet');
    } else { // Milk
      productItem.classList.add('milk-packet');
    }

    productDiv.append(productItem);
    productMainBox.append(productDiv);
  });

  // Right Section
  const rightSection = document.createElement('div');
  rightSection.classList.add('right-section', 'mt-10', 'py-0', 'position-relative', 'col-lg-8');
  row.append(rightSection);

  // Ghee Box
  const gheeBox = document.createElement('div');
  gheeBox.classList.add('ghee_box');
  rightSection.append(gheeBox);

  const gheeAccountMainBgBox = document.createElement('div');
  gheeAccountMainBgBox.classList.add('account-mainBg-box', 'w-100');
  gheeBox.append(gheeAccountMainBgBox);

  // Ghee Desktop Background
  const gheeDesktopBgOverlay = document.createElement('div');
  gheeDesktopBgOverlay.classList.add('annual-background_image--overlay', 'd-flex', 'annual-bg-desktop');
  gheeAccountMainBgBox.append(gheeDesktopBgOverlay);

  const gheeDesktopPicture = gheeBackgroundDesktopRow.querySelector('picture');
  if (gheeDesktopPicture) {
    const img = gheeDesktopPicture.querySelector('img');
    const optimizedPic = createOptimizedPicture(img.src, img.alt, false, [{ width: '750' }]);
    moveInstrumentation(img, optimizedPic.querySelector('img'));
    optimizedPic.classList.add('account-bgImg', 'with-overlay');
    gheeDesktopBgOverlay.append(optimizedPic);
  }
  const gheeDesktopOverlay = document.createElement('div');
  gheeDesktopOverlay.classList.add('overlay');
  gheeDesktopBgOverlay.append(gheeDesktopOverlay);

  // Ghee Mobile Background
  const gheeMobileBgOverlay = document.createElement('div');
  gheeMobileBgOverlay.classList.add('annual-background_image--overlay', 'd-flex', 'annual-bg-mobile');
  gheeAccountMainBgBox.append(gheeMobileBgOverlay);

  const gheeMobilePicture = gheeBackgroundMobileRow.querySelector('picture');
  if (gheeMobilePicture) {
    const img = gheeMobilePicture.querySelector('img');
    const optimizedPic = createOptimizedPicture(img.src, img.alt, false, [{ width: '750' }]);
    moveInstrumentation(img, optimizedPic.querySelector('img'));
    optimizedPic.classList.add('account-bgImg', 'with-overlay');
    gheeMobileBgOverlay.append(optimizedPic);
  }
  const gheeMobileOverlay = document.createElement('div');
  gheeMobileOverlay.classList.add('overlay');
  gheeMobileBgOverlay.append(gheeMobileOverlay);

  const gheeRightSubtextBefore = document.createElement('div');
  gheeRightSubtextBefore.classList.add('right-subtext', 'position-absolute', 'start-0', 'end-0', 'bottom-0', 'right-subtext__BeforeDownload');
  gheeAccountMainBgBox.append(gheeRightSubtextBefore);

  const gheeBeforeContent = document.createElement('div');
  gheeBeforeContent.classList.add('d-flex', 'flex-column', 'align-items-center');
  gheeRightSubtextBefore.append(gheeBeforeContent);

  const gheeMobileHeading = document.createElement('div');
  gheeMobileHeading.classList.add('ghee-mobile-heading', 'text-center', 'font-md-18', 'font-baskerville', 'leading-32');
  moveInstrumentation(gheeTextRow.firstElementChild, gheeMobileHeading);
  gheeMobileHeading.innerHTML = gheeTextRow.firstElementChild.innerHTML;
  gheeBeforeContent.append(gheeMobileHeading);

  const gheeDownloadBtn = document.createElement('button');
  gheeDownloadBtn.classList.add('annual-report_DownloadBtn', 'my-9');
  gheeBeforeContent.append(gheeDownloadBtn);

  const downloadIcon = document.createElement('div');
  downloadIcon.classList.add('download_icon');
  gheeDownloadBtn.append(downloadIcon);
  // Original HTML has a hardcoded SVG here. We don't have a model field for it.
  // Per Rule 16, do not hardcode. If there's no model field, no icon.

  const gheeDownloadLinkDiv = document.createElement('div');
  gheeDownloadLinkDiv.classList.add('d-flex', 'mb-6');
  gheeBeforeContent.append(gheeDownloadLinkDiv);

  const gheeLinkInnerDiv = document.createElement('div');
  gheeDownloadLinkDiv.append(gheeLinkInnerDiv);

  const gheeReportLinkA = document.createElement('a');
  gheeReportLinkA.classList.add('text-decoration-none', 'download-report_btn', 'cta-analytics', 'download_report_btnBefore', 'text-cream-100', 'border', 'border-2', 'border-red-100', 'border-maroon-100-hover', 'border-red-300-active', 'bg-red-100', 'bg-maroon-100-hover', 'bg-red-300-active');
  const gheeLink = gheeReportLinkRow.querySelector('a');
  if (gheeLink) {
    gheeReportLinkA.href = gheeLink.href;
    gheeReportLinkA.setAttribute('download', 'report.pdf'); // Assuming this is always a report download
  }
  moveInstrumentation(gheeReportLinkRow.firstElementChild, gheeReportLinkA);
  gheeReportLinkA.textContent = gheeReportLinkLabelRow.firstElementChild.textContent.trim();
  gheeLinkInnerDiv.append(gheeReportLinkA);

  const gheeWhatsappLinkDiv = document.createElement('div');
  gheeWhatsappLinkDiv.classList.add('Whatsapp-link', 'mb-8', 'text-center');
  gheeBeforeContent.append(gheeWhatsappLinkDiv);

  // Right subtext after download (hidden by default)
  const gheeRightSubtextAfter = document.createElement('div');
  gheeRightSubtextAfter.classList.add('right-subtext', 'position-absolute', 'start-0', 'end-0', 'bottom-0', 'right-section_subtextafter', 'right-subtext__AfterDownload');
  gheeBox.append(gheeRightSubtextAfter);

  const gheeAfterContent = document.createElement('div');
  gheeAfterContent.classList.add('d-flex', 'flex-column', 'align-items-center', 'justify-content-around');
  gheeRightSubtextAfter.append(gheeAfterContent);

  const gheeAfterHeading = document.createElement('div');
  gheeAfterHeading.classList.add('ghee-mobile-heading', 'text-center', 'font-md-18', 'font-baskerville', 'leading-32');
  gheeAfterHeading.innerHTML = '<p>Your monthly report of svasti ghee has<br>been downloaded!</p>'; // Hardcoded text from original HTML
  gheeAfterContent.append(gheeAfterHeading);

  const gheeAfterDownloadBtn = document.createElement('button');
  gheeAfterDownloadBtn.classList.add('annual-report_DownloadBtn', 'my-9');
  gheeAfterContent.append(gheeAfterDownloadBtn);

  const tickDownload = document.createElement('div');
  tickDownload.classList.add('tick_download');
  gheeAfterDownloadBtn.append(tickDownload);
  // Original HTML has a hardcoded SVG here. We don't have a model field for it.
  // Per Rule 16, do not hardcode. If there's no model field, no icon.

  const gheeAfterDownloadLinkDiv = document.createElement('div');
  gheeAfterDownloadLinkDiv.classList.add('d-flex', 'mb-6');
  gheeAfterContent.append(gheeAfterDownloadLinkDiv);

  const gheeAfterLinkInnerDiv = document.createElement('div');
  gheeAfterDownloadLinkDiv.append(gheeAfterLinkInnerDiv);

  const gheeAfterReportBtn = document.createElement('button');
  gheeAfterReportBtn.classList.add('download-report_btn', 'download_report_btnAfter', 'disabled', 'bg-light-pink', 'border-light-pink', 'text-cream-100');
  gheeAfterReportBtn.textContent = 'Download report'; // Hardcoded text from original HTML
  gheeAfterLinkInnerDiv.append(gheeAfterReportBtn);

  const gheeAfterWhatsappLinkDiv = document.createElement('div');
  gheeAfterWhatsappLinkDiv.classList.add('Whatsapp-link', 'mb-8', 'text-center');
  gheeAfterContent.append(gheeAfterWhatsappLinkDiv);

  // Milk Section
  const milkSectionImage = document.createElement('div');
  milkSectionImage.classList.add('position-relative', 'milk-section_image');
  rightSection.append(milkSectionImage);

  const milkAccountMainBgBox = document.createElement('div');
  milkAccountMainBgBox.classList.add('w-100', 'account-mainBg-box', 'd-flex');
  milkSectionImage.append(milkAccountMainBgBox);

  // Milk Desktop Background
  const milkDesktopBgOverlay = document.createElement('div');
  milkDesktopBgOverlay.classList.add('annual-background_image--overlay', 'd-flex', 'annual-bg-desktop');
  milkAccountMainBgBox.append(milkDesktopBgOverlay);

  const milkDesktopPicture = milkBackgroundDesktopRow.querySelector('picture');
  if (milkDesktopPicture) {
    const img = milkDesktopPicture.querySelector('img');
    const optimizedPic = createOptimizedPicture(img.src, img.alt, false, [{ width: '750' }]);
    moveInstrumentation(img, optimizedPic.querySelector('img'));
    optimizedPic.classList.add('account-bgImg', 'with-overlay');
    milkDesktopBgOverlay.append(optimizedPic);
  }
  const milkDesktopOverlay = document.createElement('div');
  milkDesktopOverlay.classList.add('overlay');
  milkDesktopBgOverlay.append(milkDesktopOverlay);

  // Milk Mobile Background
  const milkMobileBgOverlay = document.createElement('div');
  milkMobileBgOverlay.classList.add('annual-background_image--overlay', 'd-flex', 'annual-bg-mobile');
  milkAccountMainBgBox.append(milkMobileBgOverlay);

  const milkMobilePicture = milkBackgroundMobileRow.querySelector('picture');
  if (milkMobilePicture) {
    const img = milkMobilePicture.querySelector('img');
    const optimizedPic = createOptimizedPicture(img.src, img.alt, false, [{ width: '750' }]);
    moveInstrumentation(img, optimizedPic.querySelector('img'));
    optimizedPic.classList.add('account-bgImg', 'with-overlay');
    milkMobileBgOverlay.append(optimizedPic);
  }
  const milkMobileOverlay = document.createElement('div');
  milkMobileOverlay.classList.add('overlay');
  milkMobileBgOverlay.append(milkMobileOverlay);

  const milkRightSubtext = document.createElement('div');
  milkRightSubtext.classList.add('right-subtext', 'position-absolute', 'start-0', 'end-0', 'bottom-0', 'right-subtext-milk');
  milkSectionImage.append(milkRightSubtext);

  const milkContent = document.createElement('div');
  milkContent.classList.add('d-flex', 'flex-column', 'align-items-center');
  milkRightSubtext.append(milkContent);

  const milkMobileHeading = document.createElement('div');
  milkMobileHeading.classList.add('ghee-mobile-heading', 'text-center', 'font-md-18', 'font-baskerville', 'leading-32');
  moveInstrumentation(milkTextRow.firstElementChild, milkMobileHeading);
  milkMobileHeading.innerHTML = milkTextRow.firstElementChild.innerHTML;
  milkContent.append(milkMobileHeading);

  const milkEmptyDiv = document.createElement('div');
  milkEmptyDiv.classList.add('font-md-18', 'mt-6', 'text-center');
  milkContent.append(milkEmptyDiv);

  const milkIconDiv = document.createElement('div');
  milkIconDiv.classList.add('my-9');
  milkContent.append(milkIconDiv);
  // Original HTML has a hardcoded SVG here. We don't have a model field for it.
  // Per Rule 16, do not hardcode. If there's no model field, no icon.

  const milkWhatsappLinkDiv = document.createElement('div');
  milkWhatsappLinkDiv.classList.add('Whatsapp-link', 'mb-8', 'text-center');
  milkContent.append(milkWhatsappLinkDiv);

  const milkWhatsappLinkP = document.createElement('p');
  const milkWhatsappLinkA = document.createElement('a');
  const milkLink = milkWhatsappLinkRow.querySelector('a');
  if (milkLink) {
    milkWhatsappLinkA.href = milkLink.href;
    milkWhatsappLinkA.setAttribute('target', '_blank');
    milkWhatsappLinkA.setAttribute('rel', 'noopener noreferrer');
  }
  moveInstrumentation(milkWhatsappLinkRow.firstElementChild, milkWhatsappLinkA);
  milkWhatsappLinkA.textContent = milkWhatsappLinkLabelRow.firstElementChild.textContent.trim();
  milkWhatsappLinkP.append('Check Your Milk Report Card on ', milkWhatsappLinkA);
  const screenReaderSpan = document.createElement('span');
  screenReaderSpan.classList.add('cmp-link__screen-reader-only');
  screenReaderSpan.textContent = 'opens in a new tab';
  milkWhatsappLinkA.append(screenReaderSpan);
  milkWhatsappLinkDiv.append(milkWhatsappLinkP);

  // Event Listeners for product selection
  const gheePacket = productMainBox.querySelector('.ghee-packet');
  const milkPacket = productMainBox.querySelector('.milk-packet');

  gheePacket.addEventListener('click', () => {
    gheeBox.style.display = 'block';
    milkSectionImage.style.display = 'none';
    gheePacket.classList.add('product-hover');
    milkPacket.classList.remove('product-hover');
  });

  milkPacket.addEventListener('click', () => {
    gheeBox.style.display = 'none';
    milkSectionImage.style.display = 'block';
    milkPacket.classList.add('product-hover');
    gheePacket.classList.remove('product-hover');
  });

  // Initial state
  gheeBox.style.display = 'block';
  milkSectionImage.style.display = 'none';
  gheePacket.classList.add('product-hover');
  milkPacket.classList.remove('product-hover');

  gheeDownloadBtn.addEventListener('click', () => {
    gheeRightSubtextBefore.style.display = 'none';
    gheeRightSubtextAfter.style.display = 'block';
  });
}
