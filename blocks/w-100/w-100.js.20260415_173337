export default function decorate(block) {
  // The block model is empty, so we just apply the classes from the original HTML
  // to the block itself.
  block.classList.add('w-100', 'pt-3', 'pt-sm-3');
  block.style.background = ''; // The original HTML had an empty background style, so we apply it.
}
