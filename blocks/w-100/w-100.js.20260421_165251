import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  // The w-100 block is a simple container with no authored content.
  // It only serves to apply specific styling from the original HTML.
  // Therefore, we just apply the classes to the block itself.
  block.classList.add('w-100', 'pt-3', 'pt-sm-3');

  // If there were any child elements in the block, and we wanted to preserve them
  // or wrap them, we would iterate through block.children and use moveInstrumentation.
  // However, based on the EDS Block Structure, this block is empty.
  // So, no need to move instrumentation or replace children.
}
