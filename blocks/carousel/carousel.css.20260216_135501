.carousel-position-relative {
  position: relative;
}
.carousel-swiper {
  display: block;
  list-style: none;
  margin-left: auto;
  margin-right: auto;
  overflow: hidden;
  padding: 0;
  position: relative;
  z-index: 1;
}
.carousel-swiper-wrapper {
  box-sizing: content-box;
  display: flex;
  height: 100%;
  position: relative;
  transition-property: transform, -webkit-transform;
  transition-timing-function: initial;
  width: 100%;
  z-index: 1;
}
.carousel-swiper-slide {
  display: block;
  flex-shrink: 0;
  height: 100%;
  position: relative;
  transition-property: transform, -webkit-transform;
  width: 100%;
  /* Equivalent to 508px assuming 16px base */
  width: 31.75rem;
}
.carousel-cmp-carousel__actions {
  display: none;
}
.carousel-swiper-container {
  background-color: transparent;
  height: 0;
}
.carousel-primary-swiper__buttonNext {
  height: 2.8125rem; /* Equivalent to 45px assuming 16px base */
  margin-top: 0;
  right: 7.5rem; /* Equivalent to 120px assuming 16px base */
  top: 50%;
  transform: translateY(-50%);
  width: 2.8125rem; /* Equivalent to 45px assuming 16px base */
  position: absolute;
  cursor: pointer;
  background-color: transparent;
}
@media (max-width: 575.98px) {
  .carousel-primary-swiper__buttonNext {
    display: none;
  }
}
@media (min-width: 1200px) {
  .carousel-primary-swiper__buttonNext {
    top: calc(50% - 1.25rem); /* Equivalent to calc(50% - 20px) assuming 16px base */
  }
}
.carousel-primary-swiper__buttonPrev {
  height: 2.8125rem; /* Equivalent to 45px assuming 16px base */
  left: 7.5rem; /* Equivalent to 120px assuming 16px base */
  margin-top: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 2.8125rem; /* Equivalent to 45px assuming 16px base */
  position: absolute;
  cursor: pointer;
  background-color: transparent;
}
@media (min-width: 1200px) {
  .carousel-primary-swiper__buttonPrev {
    top: calc(50% - 1.25rem); /* Equivalent to calc(50% - 20px) assuming 16px base */
  }
}
.carousel-swiper-pagination {
  align-items: center;
  display: flex;
  justify-content: center;
  margin-top: 1rem !important; /* Equivalent to 16px assuming 16px base */
  position: relative !important;
}
.carousel-swiper-pagination-bullet {
  background-color: #414141;
  height: 0.323125rem; /* Equivalent to 5.17px assuming 16px base */
  opacity: 1 !important;
  width: 0.323125rem; /* Equivalent to 5.17px assuming 16px base */
}
.carousel-swiper-pagination-bullet-active {
  background-color: #aa1f30;
  border-radius: 50%;
  height: 0.29375rem; /* Equivalent to 4.7px assuming 16px base */
  position: relative;
  width: 0.29375rem; /* Equivalent to 4.7px assuming 16px base */
  z-index: 2;
}
.carousel-swiper-pagination-bullet-active::before {
  border: 0.05rem solid #aa1f30; /* Equivalent to 0.8px assuming 16px base */
  border-radius: 50%;
  content: "";
  height: 0.539375rem; /* Equivalent to 8.63px assuming 16px base */
  left: 50%;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 0.539375rem; /* Equivalent to 8.63px assuming 16px base */
}
