.carousel-container {
  padding-inline: 1rem;
}
.carousel-swiper {
  list-style: none;
  margin-left: auto;
  margin-right: auto;
  overflow: hidden;
  padding: 0;
  position: relative;
  z-index: 1;
}
.carousel-swiper-wrapper {
  box-sizing: content-box;
  height: 100%;
  position: relative;
  transition-property: transform, -webkit-transform;
  transition-timing-function: ease;
  width: 100%;
  z-index: 1;
}
.carousel-swiper-slide {
  display: block;
  flex-shrink: 0;
  height: 100%;
  position: relative;
  transition-property: transform, -webkit-transform;
  width: 100%;
}
.carousel-cmp-carousel__actions {
  display: none;
}
.carousel-primary-swiper-pagination {
  bottom: 0;
  transform: translateX(0);
}
.carousel-swiper-container {
  background-color: transparent;
  height: 0;
}
.carousel-primary-swiper__buttonNext {
  height: 2.8125rem; /* Equivalent to 45px assuming 16px base */
  margin-top: 0;
  right: 7.5rem; /* Equivalent to 120px assuming 16px base */
  top: 50%;
  transform: translateY(-50%);
  width: 2.8125rem; /* Equivalent to 45px assuming 16px base */
}
@media (max-width: 575.98px) {
  .carousel-primary-swiper__buttonNext {
    display: none;
  }
}
@media (min-width: 992px) {
  .carousel-primary-swiper__buttonNext {
    top: calc(50% - 1.25rem); /* Equivalent to calc(50% - 20px) assuming 16px base */
  }
}
@media (min-width: 1200px) {
  .carousel-primary-swiper__buttonNext {
    right: 7.5rem; /* Equivalent to 120px assuming 16px base */
  }
}
.carousel-primary-swiper__buttonNext .carousel-icon {
  height: 2.5625rem; /* Equivalent to 41px assuming 16px base */
  width: 2.5625rem; /* Equivalent to 41px assuming 16px base */
}
.carousel-swiper-buttonBg {
  background-color: transparent;
}
.carousel-primary-swiper__buttonPrev {
  height: 2.8125rem; /* Equivalent to 45px assuming 16px base */
  left: 7.5rem; /* Equivalent to 120px assuming 16px base */
  margin-top: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 2.8125rem; /* Equivalent to 45px assuming 16px base */
}
@media (min-width: 992px) {
  .carousel-primary-swiper__buttonPrev {
    top: calc(50% - 1.25rem); /* Equivalent to calc(50% - 20px) assuming 16px base */
  }
}
.carousel-primary-swiper__buttonPrev .carousel-swiper-iconPrev {
  height: 2.5625rem; /* Equivalent to 41px assuming 16px base */
  transform: rotate(180deg);
  width: 2.5625rem; /* Equivalent to 41px assuming 16px base */
}
.carousel-primary-swiper__buttonPrev .carousel-icon {
  height: 2.5625rem; /* Equivalent to 41px assuming 16px base */
  width: 2.5625rem; /* Equivalent to 41px assuming 16px base */
}
.carousel-primary-swiper-slide {
  --bs-aspect-ratio: 133.3333333333%;
}
.carousel-primary-swiper-slide::before {
  content: "";
  display: block;
  padding-top: var(--bs-aspect-ratio);
}
.carousel-primary-swiper-slide .carousel-banner {
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  width: 100%;
}
.carousel-primary-swiper-slide .carousel-banner-gradient img,
.carousel-primary-swiper-slide .carousel-banner-section,
.carousel-primary-swiper-slide .carousel-banner-section__wrapper,
