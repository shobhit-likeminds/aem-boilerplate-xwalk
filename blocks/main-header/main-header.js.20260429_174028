          latestPressReleaseDiv.classList.add('latest-two-press-release');
          leftDiv.append(latestPressReleaseDiv);

          const swiperContainer = document.createElement('div');
          swiperContainer.classList.add('swiper', 'scrollSwiper', 'slides');
          latestPressReleaseDiv.append(swiperContainer);

          const swiperWrapper = document.createElement('div');
          swiperWrapper.classList.add('swiper-wrapper', 'wrap');
          swiperContainer.append(swiperWrapper);

          pressReleaseSlides.forEach((row) => {
            const [pressReleaseLinkCell, pressReleaseTitleCell, pressReleaseDateCell, pressReleaseCategoryCell] = [...row.children];

            const swiperSlide = document.createElement('div');
            swiperSlide.classList.add('swiper-slide', 'content');
            swiperWrapper.append(swiperSlide);

            const descDiv = document.createElement('div');
            descDiv.classList.add('desc');
            swiperSlide.append(descDiv);

            const link = document.createElement('a');
            const foundLink = pressReleaseLinkCell.querySelector('a');
            if (foundLink) {
              link.href = foundLink.href;
            }
            link.textContent = pressReleaseTitleCell.textContent.trim();
            const p = document.createElement('p');
            p.append(link);
            descDiv.append(p);

            const dateDiv = document.createElement('div');
            dateDiv.classList.add('date');
            const dateEm = document.createElement('em');
            dateEm.textContent = pressReleaseDateCell.textContent.trim();
            dateDiv.append(dateEm);
            const categoryEm = document.createElement('em');
            categoryEm.textContent = pressReleaseCategoryCell.textContent.trim();
            dateDiv.append(categoryEm);
            descDiv.append(dateDiv);
            moveInstrumentation(row, swiperSlide);
          });

          // eslint-disable-next-line no-undef
          new Swiper(swiperContainer, {
            slidesPerView: 1,
            spaceBetween: 16,
            loop: false, // Swiper adds swiper-initialized, swiper-horizontal, swiper-backface-hidden automatically
            autoplay: {
              delay: 3000,
              disableOnInteraction: false,
            },
          });
        }
      }
    }
  }
}
