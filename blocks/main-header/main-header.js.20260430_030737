        innerSubChild.classList.toggle('active'); // Toggle 'active' on the div, not 'active-child'
      }
    });
  });

  // Load Swiper for search results if needed
  const swiperEl = block.querySelector('.scrollSwiper');
  if (swiperEl) {
    await loadCSS('https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css');
    await loadScript('https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js');
    // eslint-disable-next-line no-undef
    new Swiper(swiperEl, {
      direction: 'vertical',
      slidesPerView: 'auto',
      freeMode: true,
      scrollbar: {
        el: '.swiper-scrollbar',
      },
      mousewheel: true,
    });
  }
}
