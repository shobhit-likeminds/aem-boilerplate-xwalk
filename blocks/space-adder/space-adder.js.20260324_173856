import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  const section = document.createElement('section');
  section.classList.add('spaceAdder-verticalPadding_section', 'spaceAdder-padding-80');
  moveInstrumentation(block, section);

  // The space-adder block has no direct content, it only provides a section with specific padding.
  // Therefore, we replace the block's content with the new section.
  block.textContent = '';
  block.append(section);
}
