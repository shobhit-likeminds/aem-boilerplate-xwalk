import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  // The space-adder block is an empty block used for vertical spacing.
  // It does not have any content rows.
  // The original HTML shows it as a section with specific padding classes.
  const section = document.createElement('section');
  section.classList.add('spaceAdder-verticalPadding_section', 'spaceAdder-padding-80');

  // Move instrumentation from the block to the new section if the block has any.
  moveInstrumentation(block, section);

  // Clear the block and append the new section.
  block.textContent = '';
  block.append(section);
}
