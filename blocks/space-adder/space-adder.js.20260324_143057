import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  const section = document.createElement('section');
  section.classList.add('spaceAdder-verticalPadding_section', 'spaceAdder-padding-80');

  // The space-adder block has no fields, so block.children will be empty.
  // We simply replace the block content with the new section element.
  block.textContent = '';
  block.append(section);
}
