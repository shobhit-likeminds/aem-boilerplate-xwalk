.banner-section {
  position: relative;
}
.banner-section .banner-carousel .carousel-inner {
  height: 100%;
}
.banner-section .banner-carousel .carousel-inner {
  height: calc(100vh - 94px);
  max-height: 500px;
}
.banner-section .banner-content-wrapper {
  top: 0;
  transform: translate(90px, 10%);
  left: 0;
  bottom: 0;
  color: #fcf1e4; /* Equivalent to var(--color-light) */
  position: absolute;
}
.banner-section .banner-content-wrapper .banner-heading,
.banner-section .banner-content-wrapper .banner-description h3 {
  font-size: 25px; /* Equivalent to 2.7vw at certain breakpoints, explicitly set */
  font-family: "Paytone One";
  font-weight: 400;
  padding-bottom: 10px;
  color: rgb(60, 41, 4);
}
.banner-section .banner-content-wrapper .banner-description h3 i,
.banner-section .banner-content-wrapper .banner-description p {
  color: rgb(60, 41, 4);
}
.banner-section .banner-content-wrapper .banner-description p {
  font-size: 1rem; /* Equivalent to 16px assuming 16px base */
  line-height: 1.5rem; /* Equivalent to 24px assuming 16px base */
  text-align: center;
  margin-bottom: 8px;
  max-width: 28vw;
}
.banner-section .banner-content-wrapper .banner-cta {
  background-color: rgb(108, 48, 3);
  margin-top: 0;
  color: #fff; /* Equivalent to var(--color-light) */
  padding: 0.625rem 4.1875rem; /* Equivalent to 10px 67px assuming 16px base */
  border: transparent;
  border-radius: 1.75rem; /* Equivalent to 28px assuming 16px base */
  font-weight: 700;
  font-size: 1.5rem; /* Equivalent to 24px assuming 16px base */
}
.banner-section .banner-carousel .carousel-indicators {
  left: 0;
  margin-right: 0;
  margin-left: 7%;
  justify-content: start;
  bottom: -5px;
  background-color: transparent;
  border: 1px solid #fcf1e4; /* Equivalent to var(--color-light) */
  border-radius: 50%;
  width: 12px;
  height: 12px;
  margin-right: 5px;
  cursor: pointer;
  position: absolute;
  right: 0;
  z-index: 15;
  display: flex;
  padding-left: 0;
  margin-bottom: 1rem; /* Added for clarity, original was 0 */
  list-style: none;
}
.banner-section .banner-carousel .carousel-indicators .active {
  background-color: #fcf1e4; /* Equivalent to var(--color-light) */
  opacity: 1;
}
.banner-section .next-carousel-btn .carousel-control-prev,
.banner-section .next-carousel-btn .carousel-control-next {
  display: block !important;
  background: #fff;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  text-align: center;
  line-height: 20px;
  top: inherit;
  bottom: 50%;
  opacity: 1;
  position: absolute;
  z-index: 1;
  padding: 0;
  color: #fff;
  border: 0;
  transition: opacity 0.15s ease;
}
.banner-section .next-carousel-btn .carousel-control-prev {
  left: 10px;
  margin-left: 5px;
}
.banner-section .next-carousel-btn .carousel-control-next {
  right: 10px;
  margin-right: 5px;
}
.banner-section .carousel-control-prev-icon {
  background-image: url("/etc.clientlibs/itc-rightshift/clientlibs/clientlib-rightshift/resources/icons/next-icon.svg");
  transform: rotate(180deg);
  width: 34px;
  left: -3px;
  top: 2px;
  height: 34px;
  position: relative;
  display: inline-block;
  background-repeat: no-repeat;
  background-position: 50% 50%;
  background-size: 100% 100%;
}
.banner-section .carousel-control-next-icon {
  background-image: url("/etc.clientlibs/itc-rightshift/clientlibs/clientlib-rightshift/resources/icons/next-icon.svg");
  width: 34px;
  left: 3px;
  top: 4px;
  height: 34px;
  position: relative;
  display: inline-block;
  background-repeat: no-repeat;
  background-position: 50% 50%;
  background-size: 100% 100%;
}
.banner-section .banner-start-now:hover {
  background-color: #437d5e;
  opacity: 0.6;
  border-color: unset !important;
  text-decoration: none !important;
  box-shadow: none !important;
}
.banner-section .banner-desktop-image {
  display: block !important;
  height: 100%;
  width: 100%;
}
.banner-section .banner-mobile-image {
  display: none !important;
  width: 100%;
}

@media (max-width: 992px) {
  .banner-section .banner-content-wrapper {
    top: -5%;
  }
}
@media (max-width: 768px) {
  .banner-section .banner-content-wrapper {
    top: -2%;
  }
  .banner-section .banner-carousel .carousel-indicators {
    margin-left: 0;
    justify-content: center;
  }
  .banner-section .banner-content-wrapper {
    transform: translate(-50%, 24px);
    left: 50%;
    color: #fcf1e4; /* Equivalent to var(--color-light) */
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 20px;
    top: 0;
    max-width: 100vw !important;
    width: 100%;
  }
  .banner-section .banner-carousel .carousel-indicators {
    top: 0;
    left: unset;
    bottom: 0;
  }
  .banner-section .banner-cta {
    margin-top: 10px;
    margin-bottom: 10px;
    padding: 0.8125rem 1.75rem !important; /* Equivalent to 13px 28px assuming 16px base */
    font-size: 1rem; /* Equivalent to 16px assuming 16px base */
  }
  .banner-section .banner-heading,
  .banner-section .banner-description h3 {
    font-size: 6.4vw;
    line-height: 6.5vw;
    text-align: center;
    padding-left: 40px;
    padding-right: 40px;
  }
  .banner-section .banner-desktop-image {
    display: none !important;
  }
  .banner-section .banner-mobile-image {
    display: block !important;
  }
}
@media (max-width: 375px) {
  .banner-section .banner-content-wrapper .banner-description p {
    font-size: 0.875rem; /* Equivalent to 14px assuming 16px base */
    line-height: 1.2;
    max-width: 100%;
  }
  .banner-section .banner-content-wrapper .banner-description h3 {
    padding-bottom: 0;
  }
  .banner-section .banner-cta {
    padding: 0.875rem 2.25rem !important; /* Equivalent to 14px 36px assuming 16px base */
    font-size: 0.875rem !important; /* Equivalent to 14px assuming 16px base */
    margin-top: 2px;
  }
}