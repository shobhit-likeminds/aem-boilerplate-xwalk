.banner-section {
  position: relative;
}
.banner-section .banner-carousel-heading,
.banner-section .banner-carousel-heading h2 {
  font-size: 2.7vw; /* Equivalent to 43.2px assuming 16px base */
  font-family: "Paytone One";
  font-weight: 400;
  padding-bottom: 0.625rem; /* Equivalent to 10px assuming 16px base */
  color: #3c2904;
}
.banner-section .banner-btn-start-now {
  margin-top: 0;
  padding: 0.625rem 4.1875rem; /* Equivalent to 10px 67px assuming 16px base */
  font-size: 1.5rem; /* Equivalent to 24px assuming 16px base */
  font-weight: 700;
  border-radius: 1.75rem; /* Equivalent to 28px assuming 16px base */
  background-color: #6c3003;
  color: #fcf1e4;
  border: none;
}
.banner-section .banner-btn-start-now:hover,
.banner-section .banner-btn-start-now:focus,
.banner-section .banner-btn-start-now:active {
  opacity: 0.6;
  border-color: unset !important;
  text-decoration: none !important;
  box-shadow: none !important;
  background-color: #437d5e;
}
.banner-section .banner-content-wrapper {
  transform: translate(5.625rem, 10%); /* Equivalent to 90px assuming 16px base */
  top: 0;
  left: 0;
  bottom: 0;
  color: #fcf1e4;
  position: absolute;
  max-width: 50%;
}
.banner-section .banner-content-wrapper h3 {
  color: #3c2904;
  font-size: 1.75rem; /* Equivalent to 28px assuming 16px base */
  font-weight: 500;
  line-height: 2.1rem; /* Equivalent to 33.6px assuming 16px base */
  margin-bottom: 0.5rem; /* Equivalent to 8px assuming 16px base */
}
.banner-section .banner-content-wrapper h3 i {
  color: #3c2904;
  font-style: italic;
}
.banner-section .banner-content-wrapper p {
  color: #3c2904;
  font-size: 1rem; /* Equivalent to 16px assuming 16px base */
  line-height: 1.5rem; /* Equivalent to 24px assuming 16px base */
  margin-bottom: 1rem; /* Equivalent to 16px assuming 16px base */
  max-width: 70%;
}
.banner-section .banner-carousel-indicators {
  bottom: -0.3125rem; /* Equivalent to -5px assuming 16px base */
  left: 0;
  margin-right: 0;
  margin-left: 7%;
  justify-content: flex-start;
  position: absolute;
  right: 0;
  z-index: 15;
  display: flex;
  padding-left: 0;
  list-style: none;
  box-sizing: content-box;
  flex: 0 1 auto;
  width: 0.75rem; /* Equivalent to 12px assuming 16px base */
  height: 0.75rem; /* Equivalent to 12px assuming 16px base */
  margin-right: 0.3125rem; /* Equivalent to 5px assuming 16px base */
  cursor: pointer;
  background-color: transparent;
  border: 1px solid #fcf1e4;
  border-radius: 50%;
  text-indent: -999px;
  transition: opacity 0.6s ease;
}
.banner-section .banner-carousel-indicators .active {
  background-color: #fcf1e4;
  opacity: 1;
}
.banner-section .next-carousel-btn .carousel-control-prev,
.banner-section .next-carousel-btn .carousel-control-next {
  display: block !important;
  background: #fff;
  border-radius: 50%;
  width: 2.5rem; /* Equivalent to 40px assuming 16px base */
  height: 2.5rem; /* Equivalent to 40px assuming 16px base */
  text-align: center;
  line-height: 1.25rem; /* Equivalent to 20px assuming 16px base */
  top: 50%;
  bottom: 0;
  opacity: 1;
  position: absolute;
  z-index: 1;
  color: #fff;
  border: 0;
  cursor: pointer;
  transform: translateY(-50%);
}
.banner-section .next-carousel-btn .carousel-control-prev {
  left: 0.625rem; /* Equivalent to 10px assuming 16px base */
  margin-left: 0.3125rem; /* Equivalent to 5px assuming 16px base */
}
.banner-section .next-carousel-btn .carousel-control-next {
  right: 0.625rem; /* Equivalent to 10px assuming 16px base */
  margin-right: 0.3125rem; /* Equivalent to 5px assuming 16px base */
}
.banner-section .carousel-control-prev-icon {
  background-image: url("/content/dam/aemigrate/uploaded-folder/image/next-icon.svg");
  transform: rotate(180deg);
  top: 0.125rem; /* Equivalent to 2px assuming 16px base */
  left: -0.1875rem; /* Equivalent to -3px assuming 16px base */
  width: 2.125rem; /* Equivalent to 34px assuming 16px base */
  height: 2.125rem; /* Equivalent to 34px assuming 16px base */
  position: relative;
  display: inline-block;
  background-position: 50% 50%;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
.banner-section .carousel-control-next-icon {
  background-image: url("/content/dam/aemigrate/uploaded-folder/image/next-icon.svg");
  top: 0.25rem; /* Equivalent to 4px assuming 16px base */
  left: 0.1875rem; /* Equivalent to 3px assuming 16px base */
  width: 2.125rem; /* Equivalent to 34px assuming 16px base */
  height: 2.125rem; /* Equivalent to 34px assuming 16px base */
  position: relative;
  display: inline-block;
  background-position: 50% 50%;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}
.banner-section .banner-desktop-image {
  display: block !important;
  height: 100%;
  width: 100%;
}
.banner-section .banner-mobile-image {
  display: none !important;
  width: 100%;
}
@media (max-width: 992px) {
  .banner-section .banner-content-wrapper {
    max-width: 100vw !important;
    top: -5%;
  }
  .banner-section .banner-content-wrapper p {
    max-width: none;
  }
}
@media (max-width: 768px) {
  .banner-section .banner-content-wrapper {
    top: -2%;
    transform: translate(-50%, 1.5rem); /* Equivalent to 24px assuming 16px base */
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 1.25rem; /* Equivalent to 20px assuming 16px base */
  }
  .banner-section .banner-carousel-heading,
  .banner-section .banner-carousel-heading h2 {
    font-size: 7.47vw; /* Equivalent to 119.52px assuming 16px base */
    margin-top: 1.25rem; /* Equivalent to 20px assuming 16px base */
  }
  .banner-section .banner-carousel-description p {
    font-size: 4.2vw; /* Equivalent to 67.2px assuming 16px base */
  }
  .banner-section .banner-carousel-indicators {
    left: unset;
    top: 0;
    justify-content: center;
    margin-left: 0;
  }
  .banner-section .banner-btn-start-now {
    margin-top: 0.625rem; /* Equivalent to 10px assuming 16px base */
    margin-bottom: 0.625rem; /* Equivalent to 10px assuming 16px base */
  }
  .banner-section .banner-desktop-image {
    display: none !important;
  }
  .banner-section .banner-mobile-image {
    display: block !important;
  }
}
@media (max-width: 575.978px) {
  .banner-section .banner-carousel-indicators {
    bottom: 0;
    left: 0 !important;
    top: unset !important;
  }
  .banner-section .banner-carousel-heading,
  .banner-section .banner-carousel-heading h2 {
    font-size: 6.4vw; /* Equivalent to 102.4px assuming 16px base */
    line-height: 6.5vw; /* Equivalent to 104px assuming 16px base */
    text-align: center;
    padding-left: 2.5rem; /* Equivalent to 40px assuming 16px base */
    padding-right: 2.5rem; /* Equivalent to 40px assuming 16px base */
  }
}
@media (max-width: 375px) {
  .banner-section .banner-content-wrapper p {
    max-width: 100%;
  }
}
@media (max-width: 370px) {
  .banner-section .banner-content-wrapper p {
    font-size: 0.875rem; /* Equivalent to 14px assuming 16px base */
    line-height: 1.2; /* Equivalent to 19.2px assuming 16px base */
  }
  .banner-section .banner-content-wrapper h2 {
    padding-bottom: 0;
  }
  .banner-section .banner-btn-start-now {
    padding: 0.25rem 2rem; /* Equivalent to 4px 32px assuming 16px base */
    font-size: 1rem; /* Equivalent to 16px assuming 16px base */
  }
}
