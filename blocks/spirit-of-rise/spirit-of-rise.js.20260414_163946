import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  const [headingRow, descriptionRow, ...cardRows] = [...block.children];

  // The block already has 'spirit-of-rise' from the HTML.
  // 'section' and 'grey-bg' are also already present in the original HTML.
  // No need to add them again here.
  // block.classList.add('section', 'grey-bg');

  const container = document.createElement('div');
  container.classList.add('container');

  // Header section
  const sectionHeader = document.createElement('div');
  sectionHeader.classList.add('section-header', 'text-center', 'pb-3');
  moveInstrumentation(headingRow, sectionHeader);
  moveInstrumentation(descriptionRow, sectionHeader);

  const heading = document.createElement('h2');
  heading.classList.add('heading', 'font-regular', 'aos-init', 'aos-animate');
  heading.innerHTML = headingRow.firstElementChild.innerHTML; // Use innerHTML to preserve potential <br>

  const description = document.createElement('p');
  description.classList.add('aos-init', 'aos-animate');
  description.innerHTML = descriptionRow.firstElementChild.innerHTML; // Use innerHTML for description

  sectionHeader.append(heading, description);
  container.append(sectionHeader);

  // Cards grid
  const rowDiv = document.createElement('div');
  rowDiv.classList.add('row', 'g-4', 'purpose-led-grid', 'pt-3');

  cardRows.forEach((cardRow) => {
    const cells = [...cardRow.children];
    // Use content detection instead of direct index access
    const imageCell = cells.find(cell => cell.querySelector('picture'));
    const cardLinkCell = cells.find(cell => cell.querySelector('a') && cell.textContent.trim() !== '' && cell.textContent.trim() !== 'https://example.com/cardlinklabel'); // Assuming cardLink has actual link text
    const textCell = cells.find(cell => cell.querySelector('p')); // Assuming text cell contains a <p> tag

    const colDiv = document.createElement('div');
    colDiv.classList.add('col-md-6', 'aos-init', 'aos-animate');
    moveInstrumentation(cardRow, colDiv);

    const cardLinkElement = cardLinkCell ? cardLinkCell.querySelector('a') : null;
    const cardWrap = document.createElement('a');
    cardWrap.classList.add('card-wrap');
    if (cardLinkElement) {
      cardWrap.href = cardLinkElement.href;
      if (cardLinkElement.target) cardWrap.target = cardLinkElement.target;
    } else {
      // Fallback or handle cases where cardLink is not present
      cardWrap.href = '#'; // Or some default
    }


    const cardImageDiv = document.createElement('div');
    cardImageDiv.classList.add('card-image');
    const picture = imageCell ? imageCell.querySelector('picture') : null;
    if (picture) {
      cardImageDiv.append(picture);
    }
    cardWrap.append(cardImageDiv);

    const cardTextDiv = document.createElement('div');
    cardTextDiv.classList.add('card-text');
    const descP = document.createElement('p');
    descP.classList.add('desc');
    descP.innerHTML = textCell ? textCell.innerHTML : ''; // Use innerHTML for richtext content
    cardTextDiv.append(descP);
    cardWrap.append(cardTextDiv);

    colDiv.append(cardWrap);
    rowDiv.append(colDiv);
  });

  container.append(rowDiv);
  block.textContent = '';
  block.append(container);

  // Image optimization
  block.querySelectorAll('picture > img').forEach((img) => {
    // The original HTML uses img-fluid class, ensure it's preserved or added back if needed
    const optimizedPic = createOptimizedPicture(img.src, img.alt, false, [{ width: '750' }]);
    const newImg = optimizedPic.querySelector('img');
    if (newImg && img.classList.contains('img-fluid')) {
      newImg.classList.add('img-fluid');
    }
    moveInstrumentation(img, newImg);
    img.closest('picture').replaceWith(optimizedPic);
  });
}
