import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  const [headingRow, descriptionRow, ...cardRows] = [...block.children];

  const containerDiv = document.createElement('div');
  containerDiv.classList.add('container');

  // Section Header
  const sectionHeaderDiv = document.createElement('div');
  sectionHeaderDiv.classList.add('section-header', 'text-center', 'pb-3');

  const heading = document.createElement('h2');
  heading.classList.add('heading', 'font-regular', 'aos-init', 'aos-animate');
  moveInstrumentation(headingRow, heading);
  // heading is richtext, so use innerHTML
  heading.innerHTML = headingRow.innerHTML;
  heading.setAttribute('data-aos-easing', 'ease-in-out');
  heading.setAttribute('data-aos', 'fade-up');
  heading.setAttribute('data-aos-delay', '200');
  sectionHeaderDiv.append(heading);

  const description = document.createElement('p');
  description.classList.add('aos-init', 'aos-animate');
  moveInstrumentation(descriptionRow, description);
  // description is text, so use textContent.trim()
  description.textContent = descriptionRow.textContent.trim();
  description.setAttribute('data-aos', 'fade-up');
  description.setAttribute('data-aos-offset', '100');
  description.setAttribute('data-aos-duration', '650');
  description.setAttribute('data-aos-easing', 'ease-in-out');
  sectionHeaderDiv.append(description);

  containerDiv.append(sectionHeaderDiv);

  // Purpose Led Grid
  const purposeLedGridDiv = document.createElement('div');
  purposeLedGridDiv.classList.add('row', 'g-4', 'purpose-led-grid', 'pt-3');

  cardRows.forEach((row) => {
    const [imageMobileCell, imageDesktopCell, imageAltCell, cardLinkCell, cardDescriptionCell] = [
      ...row.children,
    ];

    const colDiv = document.createElement('div');
    colDiv.classList.add('col-md-6', 'aos-init', 'aos-animate');
    colDiv.setAttribute('data-aos-easing', 'ease-in-out');
    colDiv.setAttribute('data-aos', 'fade-up');
    colDiv.setAttribute('data-aos-delay', '700');

    const cardLink = document.createElement('a');
    cardLink.classList.add('card-wrap');
    const foundLink = cardLinkCell.querySelector('a');
    if (foundLink) {
      cardLink.href = foundLink.href;
      // Original HTML has target="_blank"
      cardLink.target = '_blank';
    }
    moveInstrumentation(row, cardLink);

    const cardImageDiv = document.createElement('div');
    cardImageDiv.classList.add('card-image');

    const picture = document.createElement('picture');
    const mobileImg = imageMobileCell.querySelector('img');
    const desktopImg = imageDesktopCell.querySelector('img');
    const altText = imageAltCell.textContent.trim();

    if (mobileImg) {
      const source = document.createElement('source');
      source.media = '(max-width: 576px)';
      source.srcset = createOptimizedPicture(mobileImg.src, altText, false, [{ width: '576' }]).querySelector('img').src;
      picture.append(source);
    }

    if (desktopImg) {
      const img = createOptimizedPicture(desktopImg.src, altText, false, [{ width: '750' }]).querySelector('img');
      img.classList.add('img-fluid');
      picture.append(img);
    }
    cardImageDiv.append(picture);
    cardLink.append(cardImageDiv);

    const cardTextDiv = document.createElement('div');
    cardTextDiv.classList.add('card-text');

    const cardDescriptionP = document.createElement('p');
    cardDescriptionP.classList.add('desc');
    cardDescriptionP.innerHTML = cardDescriptionCell.innerHTML;
    cardTextDiv.append(cardDescriptionP);
    cardLink.append(cardTextDiv);

    colDiv.append(cardLink);
    purposeLedGridDiv.append(colDiv);
  });

  containerDiv.append(purposeLedGridDiv);

  block.replaceChildren(containerDiv);
}
