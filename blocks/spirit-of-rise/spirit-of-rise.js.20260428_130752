import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  const [headingRow, descriptionRow, ...cardRows] = [...block.children];

  const sectionHeader = document.createElement('div');
  sectionHeader.classList.add('section-header', 'text-center', 'pb-3');

  const heading = document.createElement('h2');
  heading.classList.add('heading', 'font-regular', 'aos-init', 'aos-animate');
  moveInstrumentation(headingRow, heading);
  // CHECK 1.5: heading is richtext, should use innerHTML directly from the cell
  heading.innerHTML = headingRow.children[0].innerHTML;
  sectionHeader.append(heading);

  const description = document.createElement('p');
  description.classList.add('aos-init', 'aos-animate');
  moveInstrumentation(descriptionRow, description);
  // CHECK 1.5: description is richtext, should use innerHTML directly from the cell
  description.innerHTML = descriptionRow.children[0].innerHTML;
  sectionHeader.append(description);

  const purposeLedGrid = document.createElement('div');
  purposeLedGrid.classList.add('row', 'g-4', 'purpose-led-grid', 'pt-3');

  cardRows.forEach((row) => {
    // CHECK 0 & 2.6A: Fixed schema for card rows, using destructuring is correct.
    const [imageMobileCell, imageDesktopCell, imageAltCell, cardLinkCell, cardTextCell] = [
      ...row.children,
    ];

    const col = document.createElement('div');
    col.classList.add('col-md-6', 'aos-init', 'aos-animate');

    const cardLink = document.createElement('a');
    cardLink.classList.add('card-wrap');
    const foundLink = cardLinkCell.querySelector('a');
    if (foundLink) {
      cardLink.href = foundLink.href;
      cardLink.target = '_blank'; // Assuming target blank from original HTML
    }
    moveInstrumentation(cardLinkCell, cardLink);

    const cardImage = document.createElement('div');
    cardImage.classList.add('card-image');

    // The original code was creating a new <picture> element and manually appending sources and img.
    // createOptimizedPicture handles this more robustly.
    // We need to extract the img src and alt from the original picture elements in the cells.
    const mobileImg = imageMobileCell.querySelector('img');
    const desktopImg = imageDesktopCell.querySelector('img');

    if (desktopImg) { // Prioritize desktop image for alt text and primary src
      const altText = imageAltCell.textContent.trim(); // CHECK 1.5: imageAlt is type=text, use textContent
      const optimizedPic = createOptimizedPicture(
        desktopImg.src,
        altText,
        false,
        [{ media: '(max-width: 576px)', width: '750', url: mobileImg?.src }, { width: '750' }],
      );
      cardImage.append(optimizedPic);
      moveInstrumentation(desktopImg.closest('picture'), optimizedPic);
      if (mobileImg) moveInstrumentation(mobileImg.closest('picture'), optimizedPic.querySelector('source'));
    } else if (mobileImg) { // Fallback to mobile if desktop is missing
      const altText = imageAltCell.textContent.trim();
      const optimizedPic = createOptimizedPicture(
        mobileImg.src,
        altText,
        false,
        [{ width: '750' }],
      );
      cardImage.append(optimizedPic);
      moveInstrumentation(mobileImg.closest('picture'), optimizedPic);
    }
    cardLink.append(cardImage);

    const cardText = document.createElement('div');
    cardText.classList.add('card-text');
    const pDesc = document.createElement('p');
    pDesc.classList.add('desc');
    // CHECK 1.5: cardText is richtext, should use innerHTML directly from the cell
    pDesc.innerHTML = cardTextCell.innerHTML;
    cardText.append(pDesc);
    cardLink.append(cardText);

    col.append(cardLink);
    purposeLedGrid.append(col);
    moveInstrumentation(row, col);
  });

  const container = document.createElement('div');
  container.classList.add('container');
  container.append(sectionHeader, purposeLedGrid);

  block.replaceChildren(container);

  // The original createOptimizedPicture call was redundant and incorrectly placed.
  // It should be handled when creating the picture for each card.
  // Removing the block.querySelectorAll('picture > img').forEach loop as it's now handled per card.
}
