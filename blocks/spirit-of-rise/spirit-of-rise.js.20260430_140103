import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  const [headingRow, subheadingRow, ...cardRows] = [...block.children];

  const section = document.createElement('section');
  section.classList.add('section', 'grey-bg', 'spirit-of-rise');

  const sectionHeader = document.createElement('div');
  sectionHeader.classList.add('section-header', 'text-center', 'pb-3');
  moveInstrumentation(headingRow, sectionHeader);

  const heading = document.createElement('h2');
  heading.classList.add('heading', 'font-regular', 'aos-init', 'aos-animate');
  heading.setAttribute('data-aos-easing', 'ease-in-out');
  heading.setAttribute('data-aos', 'fade-up');
  heading.setAttribute('data-aos-delay', '200');
  heading.textContent = headingRow.textContent.trim();
  sectionHeader.append(heading);

  const subheading = document.createElement('p');
  subheading.classList.add('aos-init', 'aos-animate');
  subheading.setAttribute('data-aos', 'fade-up');
  subheading.setAttribute('data-aos-offset', '100');
  subheading.setAttribute('data-aos-duration', '650');
  subheading.setAttribute('data-aos-easing', 'ease-in-out');
  subheading.textContent = subheadingRow.textContent.trim();
  sectionHeader.append(subheading);

  section.append(sectionHeader);

  const performanceDriven = document.createElement('div');
  performanceDriven.classList.add('performance-driven', 'performace-driven-home');

  const container = document.createElement('div');
  container.classList.add('container');

  const cardsContainer = document.createElement('div');
  cardsContainer.classList.add('performace-driven-cards');

  cardRows.forEach((row) => {
    const [imageMobileCell, imageDesktopCell, descriptionCell, linkCell] = [...row.children];

    const linkEl = document.createElement('a');
    linkEl.classList.add('performace-driven-cards-link');
    const foundLink = linkCell.querySelector('a');
    if (foundLink) {
      linkEl.href = foundLink.href;
      linkEl.target = foundLink.target || '_blank'; // Preserve original target or default to _blank
    }
    moveInstrumentation(row, linkEl);

    const cardWrapper = document.createElement('div');
    cardWrapper.classList.add('performace-driven-card-wrapper');
    linkEl.append(cardWrapper);

    const cardImage = document.createElement('div');
    cardImage.classList.add('card-image');
    cardWrapper.append(cardImage);

    // Optimized pictures for mobile and desktop
    const mobilePicture = imageMobileCell.querySelector('picture');
    const desktopPicture = imageDesktopCell.querySelector('picture');

    if (mobilePicture && desktopPicture) {
      const imgMobile = mobilePicture.querySelector('img');
      const imgDesktop = desktopPicture.querySelector('img');

      // Create optimized picture for mobile (max-width: 576px)
      const optimizedMobilePic = createOptimizedPicture(
        imgMobile.src,
        imgMobile.alt,
        false,
        [{ media: '(max-width: 576px)', width: '576' }]
      );
      // Create optimized picture for desktop (default)
      const optimizedDesktopPic = createOptimizedPicture(
        imgDesktop.src,
        imgDesktop.alt,
        false,
        [{ width: '750' }]
      );

      // Append the source from the mobile optimized picture
      const mobileSource = optimizedMobilePic.querySelector('source');
      if (mobileSource) {
        cardImage.append(mobileSource);
      }

      // Append the img from the desktop optimized picture
      const desktopImg = optimizedDesktopPic.querySelector('img');
      if (desktopImg) {
        cardImage.append(desktopImg);
        // Move instrumentation from the original img to the new optimized img
        moveInstrumentation(imgMobile, desktopImg); // Use one of the original imgs for instrumentation source
      }
    }


    const homeBoxCard = document.createElement('div');
    homeBoxCard.classList.add('performace-driven-home-box-card');
    cardWrapper.append(homeBoxCard);

    const description = document.createElement('p');
    description.classList.add('desc');
    description.innerHTML = descriptionCell.innerHTML; // Use innerHTML to preserve line breaks
    homeBoxCard.append(description);

    cardsContainer.append(linkEl);
  });

  container.append(cardsContainer);
  performanceDriven.append(container);
  section.append(performanceDriven);

  block.replaceChildren(section);
}
