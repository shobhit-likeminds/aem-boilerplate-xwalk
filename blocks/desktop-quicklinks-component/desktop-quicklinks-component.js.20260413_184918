import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  // The block has no fields in its model, so it will be empty.
  // The original HTML also shows an empty div with just the component class.
  // Therefore, no elements need to be created or modified within the block.
  // We just ensure the block has its primary class.
  block.classList.add('desktop-quicklinks-component');
}
