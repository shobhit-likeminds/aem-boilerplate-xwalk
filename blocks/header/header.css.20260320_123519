.header-itc-header-section {
  position: fixed;
  width: 100%;
  background-color: #fff;
  z-index: 9999;
  top: 0;
  left: 0;
}
.header-itc-header-section .header-navbar {
  height: 92px;
  position: relative;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  padding: 0.5rem 1rem;
  background-color: #f8f9fa;
  padding-right: 48px; /* Equivalent to 3rem assuming 16px base */
  padding-left: 48px; /* Equivalent to 3rem assuming 16px base */
}
.header-itc-header-section .header-navbar-toggler {
  border: 0;
  padding: 0.25rem 0.75rem;
  font-size: 1.25rem; /* Equivalent to 20px assuming 16px base */
  line-height: 1;
  background-color: transparent;
  border-radius: 0.25rem; /* Equivalent to 4px assuming 16px base */
}
.header-itc-header-section .header-navbar-toggler-icon {
  display: inline-block;
  width: 1.5em; /* Equivalent to 24px assuming 16px base */
  height: 1.5em; /* Equivalent to 24px assuming 16px base */
  vertical-align: middle;
  content: "";
  background: 50%/100% 100% no-repeat;
}
.header-itc-header-section .header-logo {
  display: block;
  width: 232.047px;
  height: 90px;
}
.header-itc-header-section .header-header-logo-div {
  display: flex;
  flex-direction: row;
  gap: 20px;
  align-items: center;
}
.header-itc-header-section .header-header-logo-div a {
  padding-top: 14px;
}
.header-itc-header-section .header-itc-logo-image {
  width: auto;
  height: 63px;
  object-fit: contain;
  padding-left: 0;
  border-right: 1px solid #2d2119;
  padding-right: 20px;
}
.header-itc-header-section .header-cmp-image__image {
  padding-left: 0;
}
.header-itc-header-section .header-collapse {
  flex-basis: 100%;
  flex-grow: 1;
  align-items: center;
  display: flex !important;
  flex-direction: row;
  justify-content: space-between !important;
}
.header-itc-header-section .header-nav-item {
  display: flex;
  align-items: center;
}
.header-itc-header-section .header-cmp-navigation {
  display: block;
  width: 213px;
  height: 24px;
}
.header-itc-header-section .header-cmp-navigation__group {
  display: flex;
  list-style-type: none;
  padding-left: 40px;
  margin-bottom: 0;
}
.header-itc-header-section .header-cmp-navigation__item {
  display: list-item;
  padding-right: 22px;
  font-size: 16px;
}
.header-itc-header-section .header-cmp-navigation__item-link {
  color: #533012;
  text-decoration: none;
  padding-bottom: 5px;
}
.header-itc-header-section .header-cmp-navigation__item--level-0.header-cmp-navigation__item--active .header-cmp-navigation__item-link,
.header-itc-header-section .header-cmp-navigation__item--level-0:hover .header-cmp-navigation__item-link {
  color: #4f250a;
  border-bottom: 2px solid #4f2500;
  transition: 0.3s all ease;
}
.header-itc-header-section .header-header-section {
  width: fit-content;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.header-itc-header-section .header-search-icon {
  background: none;
  color: black;
  padding: 2px 5px;
  border-radius: 5px;
  cursor: pointer;
  gap: 4px;
  font-size: 14px;
  font-weight: bold;
  display: flex;
  align-items: center;
}
.header-itc-header-section .header-country-code {
  display: block;
  font-size: 14px;
  font-weight: 700;
  line-height: 21px;
}
.header-itc-header-section .header-country-flag {
  width: 19px;
  height: 19px;
  border-radius: 50%;
  object-fit: cover;
}
.header-itc-header-section .header-dropdown-icon {
  vertical-align: middle;
  border-style: none;
}
.header-itc-header-icon-list {
  display: flex;
  align-items: center;
  text-align: right;
}
.header-itc-header-icon-list .header-nav-link {
  color: #2d2119;
  font-size: 16px;
  display: block;
  padding: 0.5rem 1rem;
}
.header-itc-header-icon-list #searchIcon {
  cursor: pointer;
}
.header-itc-header-icon-list .header-d-block {
  display: block !important;
  font-size: 10px;
}
.header-search-block {
  position: relative;
  max-width: 300px;
  right: -60px;
  top: unset;
  transform: unset;
}
.header-search-box {
  border: 1px solid #000;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 15px;
  justify-content: space-between;
  padding: 10px;
}
.header-search-container {
  display: flex;
  align-items: center;
  border: 1px solid #ccc;
  padding: 5px;
  border-radius: 5px;
  width: 100%;
}
.header-search-container.header-hidden {
  display: none;
}
.header-search-box #searchInput {
  border: 0;
  outline: 0;
  padding: 5px;
  flex: 1;
}
.header-search-box #searchButton {
  background: none;
  border: 0;
  cursor: pointer;
}
.header-search-results {
  border: 1px solid #ccc;
  padding: 10px;
  background: #fff;
  border-radius: 5px;
  position: absolute;
  top: 100%;
  left: 0;
  z-index: 1000;
  width: calc(100% + 50px);
  max-height: 380px;
  overflow-y: auto;
}
.header-search-results.header-hidden {
  display: none;
}
.header-search-results .header-resultList {
  text-align: left;
  margin-top: 0;
  margin-bottom: 0.5rem; /* Equivalent to 8px assuming 16px base */
}
.header-search-results ul {
  list-style: none;
  padding-left: 0;
}
.header-search-results li {
  margin-bottom: 10px;
}
.header-search-results a {
  text-decoration: none;
  color: #000;
}
.header-search-results #viewAllButton {
  background-color: green;
  color: white;
  padding: 10px;
  border: 0;
  cursor: pointer;
  width: 100%;
  text-align: center;
  margin-top: 10px;
  border-radius: 5px;
}
.header-modal {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 10000;
  display: none;
  width: 100%;
  height: 100%;
  overflow: hidden;
  outline: 0;
  background-color: rgba(0, 0, 0, 0.4);
}
.header-modal.header-show {
  display: block;
}
.header-modal-dialog {
  position: relative;
  width: auto;
  margin: 1.75rem auto; /* Equivalent to 28px assuming 16px base */
  pointer-events: none;
  max-width: 500px;
}
.header-modal-dialog-centered {
  display: flex;
  align-items: center;
  min-height: calc(100% - 3.5rem);
}
.header-modal-content {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  pointer-events: auto;
  background-color: #faf6f2;
  background-clip: padding-box;
  border: 1px solid rgba(0, 0, 0, 0.2);
  border-radius: 0.3rem; /* Equivalent to 4.8px assuming 16px base */
  outline: 0;
}
.header-modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 1rem; /* Equivalent to 16px assuming 16px base */
  border-bottom: 0;
  text-align: center;
  border-top-left-radius: calc(0.3rem - 1px); /* Equivalent to 3.8px assuming 16px base */
  border-top-right-radius: calc(0.3rem - 1px); /* Equivalent to 3.8px assuming 16px base */
}
.header-modal-header .header-w-100 {
  width: 100%;
  display: block;
}
.header-modal-header .header-modal-title {
  font-size: 30px;
  font-family: inherit;
  font-weight: bold;
  color: #4f250a;
  line-height: 1;
  margin-bottom: 0;
}
.header-modal-header .header-experience-text {
  font-family: "Cataneo";
  font-size: 45px;
  font-weight: normal;
  color: #eeb144;
  margin-bottom: 0;
  font-style: italic;
}
.header-modal-body {
  position: relative;
  flex: 1 1 auto;
  padding: 1rem; /* Equivalent to 16px assuming 16px base */
  padding-top: 0 !important;
  padding-bottom: 26px !important;
}
.header-modal-body .header-country-options {
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
}
.header-modal-body .header-country-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: auto;
  margin-left: 1rem; /* Equivalent to 16px assuming 16px base */
  margin-right: 1rem; /* Equivalent to 16px assuming 16px base */
}
.header-modal-body .header-country-flag {
  width: 82px;
  height: 82px;
  display: block;
  object-fit: fill;
  object-position: 50% 50%;
}
.header-modal-body .header-country-name {
  color: #282828;
  font-size: 16px;
  font-weight: bold;
  text-align: center;
  line-height: 1cm;
  margin-bottom: 0;
}

@media (max-width: 1200px) {
  .header-itc-header-section .header-navbar {
    height: 78px;
    padding-right: 1rem; /* Equivalent to 16px assuming 16px base */
    padding-left: 1rem; /* Equivalent to 16px assuming 16px base */
  }
  .header-itc-header-section .header-navbar-toggler-icon {
    max-width: 22px;
    background: url("../../../content/dam/kitchens-of-india/placeholders/vector-four.svg") no-repeat;
  }
  .header-itc-header-section .header-navbar-toggler.header-collapsed .header-navbar-toggler-icon {
    background: url("../../../content/dam/kitchens-of-india/placeholders/menu.svg") no-repeat;
    max-width: 22px;
  }
  .header-itc-header-section .header-header-logo-div {
    gap: 10px;
  }
  .header-itc-header-section .header-header-logo-div a {
    padding-top: 0;
  }
  .header-itc-header-section .header-itc-logo-image {
    height: 47px;
    padding-right: 0;
  }
  .header-itc-header-section .header-collapse {
    position: absolute;
    background: #fff7e3;
    min-width: 300px;
    width: 89%;
    z-index: 1;
    padding: 10px;
    top: 66px;
    height: 100vh;
  }
  .header-itc-header-section .header-cmp-navigation__group {
    display: block;
    padding-left: 10px; /* Equivalent to 16px assuming 16px base */
  }
  .header-itc-header-section .header-cmp-navigation__item {
    padding: 10px 0 !important;
    font-size: 1rem !important; /* Equivalent to 16px assuming 16px base */
  }
  .header-itc-header-section .header-cmp-navigation__item-link {
    color: #fff;
    font-weight: 700;
  }
  .header-itc-header-section .header-cmp-navigation__item--level-0.header-cmp-navigation__item--active .header-cmp-navigation__item-link,
  .header-itc-header-section .header-cmp-navigation__item--level-0:hover .header-cmp-navigation__item-link {
    border-bottom: 2px solid #f8f9fa;
  }
  .header-itc-header-section .header-header-section {
    padding-left: 13px;
    padding-top: 10px;
  }
  .header-itc-header-icon-list .header-nav-link {
    font-size: 2vw;
  }
  .header-itc-header-icon-list .header-d-block {
    font-size: 8px;
  }
  .header-search-block {
    max-width: 300px;
    top: 50%;
    transform: translateY(-50%);
  }
  .header-search-box {
    padding: 10px;
  }
  .header-search-results {
    width: 100%;
    left: 0;
  }
  .header-modal-dialog {
    margin: 0.5rem;
  }
  .header-modal-dialog-centered {
    min-height: calc(100% - 1rem);
  }
}

@media (max-width: 767.98px) {
  .header-itc-header-section {
    padding-top: 78px !important;
  }
  .header-itc-header-section .header-navbar {
    height: 78px;
  }
  .header-itc-header-section .header-header-logo-div {
    gap: 10px;
  }
  .header-itc-header-section .header-itc-logo-image {
    width: 60px;
  }
  .header-itc-header-icon-list .header-nav-link {
    font-size: 2vw;
  }
  .header-itc-header-icon-list .header-d-block {
    font-size: 8px;
  }
  .header-search-block {
    max-width: 100vw !important;
    left: 0;
    right: 0;
    top: 100%;
    transform: none;
  }
  .header-search-results {
    width: calc(100% - 30px);
    left: 15px;
  }
  .header-modal-header .header-modal-title {
    font-size: 28px;
  }
  .header-modal-header .header-experience-text {
    font-size: 35px;
  }
  .header-modal-body .header-country-flag {
    width: 60px;
    height: 60px;
  }
  .header-modal-body .header-country-name {
    font-size: 14px;
    line-height: 1.2;
  }
}

@media (max-width: 374px) {
  .header-itc-header-section .header-header-logo-div {
    gap: 10px;
  }
  .header-itc-header-section .header-itc-logo-image {
    width: 37px;
  }
  .header-itc-header-icon-list .header-nav-link {
    font-size: 2vw;
  }
  .header-itc-header-icon-list .header-d-block {
    font-size: 8px;
  }
}
