import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  // Destructuring block.children is acceptable here because the block structure
  // is strictly defined with a fixed number of rows, each representing a distinct field.
  const [
    imageDesktopRow,
    imageMobileRow,
    breadcrumbRow,
    headingRow,
    descriptionRow,
  ] = [...block.children];

  block.classList.add('op1');

  const figure = document.createElement('figure');

  // Image Desktop
  const desktopPicture = imageDesktopRow.querySelector('picture');
  if (desktopPicture) {
    const desktopImg = desktopPicture.querySelector('img');
    if (desktopImg) {
      const optimizedDesktopPic = createOptimizedPicture(desktopImg.src, desktopImg.alt, false, [{ width: '1440' }]);
      const newDesktopImg = optimizedDesktopPic.querySelector('img');
      newDesktopImg.classList.add('hidden-xs', 'lazyloaded');
      moveInstrumentation(desktopImg, newDesktopImg);
      figure.append(optimizedDesktopPic);
    }
  }
  moveInstrumentation(imageDesktopRow, figure);

  // Image Mobile
  const mobilePicture = imageMobileRow.querySelector('picture');
  if (mobilePicture) {
    const mobileImg = mobilePicture.querySelector('img');
    if (mobileImg) {
      const optimizedMobilePic = createOptimizedPicture(mobileImg.src, mobileImg.alt, false, [{ width: '373' }]);
      const newMobileImg = optimizedMobilePic.querySelector('img');
      newMobileImg.classList.add('visible-xs', 'lazyload');
      moveInstrumentation(mobileImg, newMobileImg);
      figure.append(optimizedMobilePic);
    }
  }
  moveInstrumentation(imageMobileRow, figure);

  block.textContent = '';
  block.append(figure);

  // Container for breadcrumbs
  const containerDiv = document.createElement('div');
  containerDiv.classList.add('container');

  const breadcrumbsDiv = document.createElement('div');
  breadcrumbsDiv.classList.add('breadcrumbs', 'hidden-sm', 'hidden-xs');
  containerDiv.append(breadcrumbsDiv);

  const blockJswDiv = document.createElement('div');
  blockJswDiv.classList.add('block', 'block-jsw');
  breadcrumbsDiv.append(blockJswDiv);

  const contentDiv = document.createElement('div');
  contentDiv.classList.add('content');
  blockJswDiv.append(contentDiv);

  // Correctly extract content from the breadcrumb row's cell
  const breadcrumbCell = [...breadcrumbRow.children].find(cell => cell.querySelector('a') || cell.textContent.trim());
  if (breadcrumbCell) {
    const breadcrumbLink = breadcrumbCell.querySelector('a');
    if (breadcrumbLink) {
      const homeLink = document.createElement('a');
      homeLink.href = 'https://jswsteelstaging.jsw.in/'; // Hardcoded as per original HTML
      homeLink.textContent = 'Home';
      contentDiv.append(homeLink);

      const splitSpan = document.createElement('span');
      splitSpan.classList.add('split');
      const icon = document.createElement('i');
      icon.classList.add('fa', 'fa-arrow-right');
      splitSpan.append(icon);
      contentDiv.append(splitSpan);

      // Append the text content of the breadcrumb link's parent cell
      // This handles cases where there might be text nodes directly in the cell
      const breadcrumbText = document.createTextNode(breadcrumbLink.textContent);
      contentDiv.append(breadcrumbText);
      moveInstrumentation(breadcrumbCell, contentDiv); // Instrument the cell, not the row
    } else {
      // If no breadcrumb link, just append the content of the cell as is
      moveInstrumentation(breadcrumbCell, contentDiv);
      while (breadcrumbCell.firstChild) contentDiv.append(breadcrumbCell.firstChild);
    }
  }

  block.append(containerDiv);

  // Banner Info
  const bannerInfoDiv = document.createElement('div');
  bannerInfoDiv.classList.add('banner-info');
  block.append(bannerInfoDiv);

  const bannerInfoContainer = document.createElement('div');
  bannerInfoContainer.classList.add('container');
  bannerInfoDiv.append(bannerInfoContainer);

  const bannerCardDiv = document.createElement('div');
  bannerCardDiv.classList.add('banner-card', 'os-animation', 'animated', 'fadeIn');
  bannerInfoContainer.append(bannerCardDiv);

  const headingEl = document.createElement('h1');
  headingEl.classList.add('os-animation', 'hd1', 'animated', 'fadeIn');
  moveInstrumentation(headingRow, headingEl);
  while (headingRow.firstChild) headingEl.append(headingRow.firstChild);
  bannerCardDiv.append(headingEl);

  const descriptionEl = document.createElement('p');
  descriptionEl.classList.add('os-animation', 'animated', 'fadeIn');
  moveInstrumentation(descriptionRow, descriptionEl);
  while (descriptionRow.firstChild) descriptionEl.append(descriptionRow.firstChild);
  bannerCardDiv.append(descriptionEl);
}
